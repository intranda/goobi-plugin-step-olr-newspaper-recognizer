<block-fields>
	<div class="d-flex flex-column gap-2">
		<!-- type, hidden data and tools share one input group, so they line up with the field -->
		<div class="form-group p-0 m-0 position-relative {props.flags.missingType || props.flags.notAllowed ? 'has-validation-error' : ''}">
			<div class="input-group flex-nowrap">
				<label class="input-group-text" style={LABEL_STYLE} for={fieldId('type')}>
					<span if={props.color} aria-hidden="true" class="me-2" style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: {props.color};"></span>
					<span if={!props.color} aria-hidden="true" class="icon-wrapper me-2"><svg><use href="{GoobiIcons.iconHref('category')}" /></svg></span>
					{props.t('plugin_newspaperRecognizer_preview_type')}
				</label>
				<select class="form-select" id={fieldId('type')} onchange={e => props.handleType(e.target.value || null)}>
					<option value="" selected={!props.start.type}>{props.t('plugin_newspaperRecognizer_pleaseSelect')}</option>
					<option each={option in props.typeOptions} value={option.name} selected={option.name === props.start.type}>{option.label}</option>
				</select>
				<button if={hiddenCount() > 0} type="button" class="btn btn-blank text-nowrap d-flex align-items-center gap-2" onclick={() => props.handleToggleHidden()}
					title={hiddenTitle()} aria-label={hiddenTitle()} aria-expanded={props.hiddenOpen ? 'true' : 'false'}>
					<span if={structures().length > 0} class="d-flex align-items-center gap-1"><span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('stack-2')}" /></svg></span> {structures().length}</span>
					<span if={metadata().length > 0} class="d-flex align-items-center gap-1"><span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('notes')}" /></svg></span> {metadata().length}</span>
				</button>
				<button type="button" class="btn btn-blank" onclick={() => props.handlePattern()}
					title={props.t('plugin_newspaperRecognizer_typePattern')} aria-label={props.t('plugin_newspaperRecognizer_typePattern')}>
					<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('repeat')}" /></svg></span>
				</button>
				<button if={props.handleContinue} type="button" class="btn btn-blank" onclick={() => props.handleContinue()}
					title={props.t('plugin_newspaperRecognizer_continueFromHere')} aria-label={props.t('plugin_newspaperRecognizer_continueFromHere')}>
					<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('calendar-repeat')}" /></svg></span>
				</button>
			</div>
			<span if={props.flags.missingType} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_missingType')}</span>
			<span if={props.flags.notAllowed} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_notAllowed')}</span>
			<hidden-popover if={props.hiddenOpen} summary={props.start.hidden} t={props.t}
				handle-close={() => props.handleToggleHidden()} handle-remove={props.handleRemoveHidden}></hidden-popover>
		</div>

		<div if={props.info && props.info.dated} class="form-group p-0 m-0 {props.flags.invalidDate || props.flags.missingDate || props.flags.duplicate ? 'has-validation-error' : ''}">
			<div class="input-group flex-nowrap">
				<label class="input-group-text" style={LABEL_STYLE} for={fieldId('date')}>
					<span aria-hidden="true" class="icon-wrapper me-2"><svg><use href="{GoobiIcons.iconHref('calendar')}" /></svg></span>
					{props.t('plugin_newspaperRecognizer_date')}{props.info.dateRequired ? ' *' : ''}
				</label>
				<input type="text" class="form-control" id={fieldId('date')} value={props.start.dateInput} placeholder={props.dateFormatPattern}
					onkeyup={e => props.handleDate(e.target.value)} onblur={e => props.handleDate(e.target.value)} />
			</div>
			<span if={props.flags.invalidDate} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_wrongDateFormat')} {props.dateFormatPattern}</span>
			<span if={props.flags.missingDate} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_missingRequired')}</span>
			<span if={props.flags.duplicate} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_duplicate')}</span>
		</div>

		<div if={props.info && props.info.numbered} class="form-group p-0 m-0 {props.flags.missingNumber ? 'has-validation-error' : ''}">
			<div class="input-group flex-nowrap">
				<label class="input-group-text" style={LABEL_STYLE} for={fieldId('number')}>
					<span aria-hidden="true" class="icon-wrapper me-2"><svg><use href="{GoobiIcons.iconHref('hash')}" /></svg></span>
					{props.t('plugin_newspaperRecognizer_nro')}{props.info.numberRequired ? ' *' : ''}
				</label>
				<input if={props.info.partNumbered} type="text" class="form-control" value={props.start.prefix || ''}
					aria-label={props.t('prefix')} placeholder={props.t('prefix')} onkeyup={e => props.handleField('prefix', e.target.value)} />
				<input type="text" class="form-control" id={fieldId('number')} value={props.start.number || ''}
					onkeyup={e => props.handleField('number', e.target.value)} />
				<input if={props.info.partNumbered} type="text" class="form-control" value={props.start.suffix || ''}
					aria-label={props.t('suffix')} placeholder={props.t('suffix')} onkeyup={e => props.handleField('suffix', e.target.value)} />
			</div>
			<span if={props.flags.missingNumber} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_missingRequired')}</span>
		</div>
	</div>

	<script>
	import HiddenPopover from './hidden-popover.riot'

	let counter = 0;

	export default {
		components: {
			HiddenPopover,
		},
		// all labels get the same width, so the fields of a block line up
		LABEL_STYLE: 'min-width: 6.5rem;',
		onBeforeMount() {
			this.fieldPrefix = 'blockField' + (++counter);
		},
		fieldId(name) {
			return this.fieldPrefix + '-' + name;
		},
		structures() {
			return (this.props.start.hidden && this.props.start.hidden.structures) || [];
		},
		metadata() {
			return (this.props.start.hidden && this.props.start.hidden.metadata) || [];
		},
		hiddenCount() {
			return this.structures().length + this.metadata().length;
		},
		hiddenTitle() {
			return this.props.t('plugin_newspaperRecognizer_hidden_badgeTitle')
				.replace('{0}', this.structures().length)
				.replace('{1}', this.metadata().length);
		},
	}
	</script>
</block-fields>
