<app>
	<div if={!msgsLoaded} class="box box--neutral section">
		<div class="box__content">
			<div class="box__title">
				<h2>
					<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('puzzle')}" /></svg></span>
					{props.title}
				</h2>
			</div>
			<div class="section-body-padded" style="background-color:#eee;">
				<div class="text-center">
					<img src="template/img/goobi/ajaxloader2.gif" style="max-height: 140px;"></img>
				</div>
			</div>
		</div>
	</div>

	<div if={!!msgsLoaded} class="box box--neutral section">
		<div class="box__content">
			<div class="box__title">
				<h2>
					<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('puzzle')}" /></svg></span>
					{props.title}
				</h2>
				<div class="actions d-flex align-items-center">
					<span id="ajaxloaderbottom" class="me-2" style="display: none;">
						<img src="template/img/goobi/ajaxloader2.gif" alt="" style="height: 20px;" />
					</span>
					<!-- the menu comes first: the button must stay the last child, else Goobi's :not(:last-child) margin moves it -->
					<div class="position-relative me-2">
						<ul if={actionsOpen} class="dropdown-menu dropdown-menu-end show" style="position: absolute; right: 0; top: 100%;">
							<li><button type="button" class="dropdown-item" onclick={() => runAction(askResetToAnalysis)}>{t('plugin_newspaperRecognizer_action_takeAnalysis')}</button></li>
							<li><button type="button" class="dropdown-item" onclick={() => runAction(askRemoveAllBlocks)}>{t('plugin_newspaperRecognizer_removeAllBlocks')}</button></li>
							<li><hr class="dropdown-divider" /></li>
							<li><button type="button" class="dropdown-item" onclick={() => runAction(askRecompute)}>{t('plugin_newspaperRecognizer_action_restartAnalysis')}</button></li>
						</ul>
						<a class="btn d-flex align-items-center btn--title-action{saveInFlight ? ' disabled' : ''}" onclick={toggleActions}
							title={t('plugin_newspaperRecognizer_actions_more')} aria-label={t('plugin_newspaperRecognizer_actions_more')}
							aria-haspopup="true" aria-expanded={actionsOpen ? 'true' : 'false'}>
							<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('dots-vertical')}" /></svg></span>
						</a>
					</div>
					<a class="btn d-flex align-items-center btn--title-action{saveInFlight ? ' disabled' : ''}" onclick={exit} title={t('pluginLeave')} data-bs-toggle="tooltip">
						<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('x')}" /></svg></span>
					</a>
					<a class="btn d-flex align-items-center btn--title-action{canSave() ? '' : ' disabled'}" onclick={save} title={t('save')} data-bs-toggle="tooltip">
						<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('device-floppy')}" /></svg></span>
					</a>
					<a class="btn d-flex align-items-center btn--title-action{canSave() ? '' : ' disabled'}" onclick={saveAndExit} title={t('pluginSaveAndLeave')} data-bs-toggle="tooltip">
						<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('logout')}" /></svg></span>
					</a>
				</div>
			</div>

			<div data-help class="newspaper-help">
				<div if={!helpHidden} data-help-hints class="newspaper-help__hints">
					<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('hand-click')}" /></svg></span>
					<span><b class="me-1">{t('plugin_newspaperRecognizer_pagination_help_small')}</b> {t('plugin_newspaperRecognizer_pagination_help_smallText')}</span>
					<span><b class="me-1">{t('plugin_newspaperRecognizer_pagination_help_big')}</b> {t('plugin_newspaperRecognizer_pagination_help_bigText')}</span>
					<span><b class="me-1">{t('plugin_newspaperRecognizer_pagination_help_supplement')}</b> {t('plugin_newspaperRecognizer_pagination_help_supplementText')}</span>
					<span><b class="me-1">{t('plugin_newspaperRecognizer_pagination_help_zoom')}</b> {t('plugin_newspaperRecognizer_pagination_help_zoomText')}</span>
					<button type="button" data-help-close class="btn btn-blank btn-sm ms-auto p-0 px-1" onclick={hideHelp}
						title={t('plugin_newspaperRecognizer_pagination_help_hide')} aria-label={t('plugin_newspaperRecognizer_pagination_help_hide')}>
						<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('x')}" /></svg></span>
					</button>
				</div>
				<div data-last class="newspaper-help__last text-muted {last ? '' : 'newspaper-help__last--empty'}" aria-live="polite">
					{last ? fmt('plugin_newspaperRecognizer_pagination_last', last.text) : ''}
					<button if={last && last.undoable && undoStep} type="button" data-undo class="btn btn-link btn-sm p-0 align-baseline" onclick={undoStep}>
						{t('plugin_newspaperRecognizer_pagination_undo')}
					</button>
				</div>
			</div>

			<div>
				<div if={configErrors.length > 0} class="p-3">
					<div class="alert alert-danger">
						{t('plugin_newspaperRecognizer_configError')}
						<ul class="mb-0"><li each={error in configErrors}>{error}</li></ul>
					</div>
				</div>
				<div if={otherNotices().length > 0} class="p-3">
					<div class="alert alert-warning">
						<ul class="mb-0"><li each={notice in otherNotices()}>{formatNotice(notice)}</li></ul>
					</div>
				</div>
				<div if={hiddenBlocks().length > 0 || volumeHidden.structures.length > 0} class="p-3">
					<div class="alert alert-info">
						<ul class="mb-0 list-unstyled d-flex flex-column gap-1">
							<li if={hiddenBlocks().length > 0} class="d-flex align-items-center gap-3">
								<span>{t('plugin_newspaperRecognizer_hidden_notice').replace('{0}', hiddenBlocks().length)}</span>
								<button type="button" class="btn btn-blank btn-sm text-nowrap" onclick={jumpToNextHidden}>
									{t(hiddenBlocks().length > 1 ? 'plugin_newspaperRecognizer_validation_jumpNext' : 'plugin_newspaperRecognizer_validation_jump')}
								</button>
							</li>
							<li if={volumeHidden.structures.length > 0} class="d-flex align-items-center gap-3 position-relative">
								<span>{t('plugin_newspaperRecognizer_notice_volumeHidden').replace('{0}', volumeHidden.structures.length)}</span>
								<button type="button" class="btn btn-blank btn-sm text-nowrap" onclick={() => toggleHidden('volume')}>
									{t('plugin_newspaperRecognizer_hidden_show')}
								</button>
								<hidden-popover if={openHidden === 'volume'} summary={volumeHidden} align="left" t={t}
									handle-close={() => toggleHidden('volume')}></hidden-popover>
							</li>
						</ul>
					</div>
				</div>
				<div if={!validation.valid} class="p-3">
					<div class="alert alert-danger">
						{t('plugin_newspaperRecognizer_validation_title')}
						<ul class="mb-0 list-unstyled d-flex flex-column gap-1 mt-1">
							<li each={problem in validationProblems()} class="d-flex align-items-center gap-3">
								<span>{t(problem.key).replace('{0}', problem.count)}</span>
								<button type="button" class="btn btn-blank btn-sm text-nowrap" onclick={() => jumpToProblem(problem.name)}>
									{t(problem.count > 1 ? 'plugin_newspaperRecognizer_validation_jumpNext' : 'plugin_newspaperRecognizer_validation_jump')}
								</button>
							</li>
						</ul>
					</div>
				</div>

				<div if={!imagesLoaded} class="row">
					<div class="section-body-padded">
						<h3>{t('plugin_newspaperRecognizer_loadingImages')}...</h3>
						<progress max={pages.length} value={loadedImages}></progress>
					</div>
				</div>

				<template if={imagesLoaded}>
					<div class="section-body">
						<div class="issues">
							<template each={row in rows} key={row.loose ? 'loose-' + row.pages[0] : 'block-' + row.node.first}>
								<template if={row.loose}>
									<div class="thumbnail-image px-3 pb-3"></div>
									<div class="issue-controls d-flex flex-column gap-2 px-3 pb-3">
										<strong>{t('plugin_newspaperRecognizer_pagesWithoutStructure')}</strong>
										<span class="small text-muted">{pagesSummary(row.pages[0] + 1, row.pages[row.pages.length - 1] + 1)}</span>
									</div>
									<div class="thumbnails px-3 pb-3" style="--thumb-size: {thumb_height / 2.5}px;">
										<div each={index in row.pages} key={pages[index].filename} class="newspaper-thumbnail">
											<div class="newspaper-thumbnail__image position-relative" style="min-height: {thumb_height / 2}px;">
												<a onclick={e => onPageClick(e, index)}>
													<thumbcanvas width={thumb_height / 2} height={thumb_height / 2}
														image_small={pages[index].image.thumbnailUrl} image_large={pages[index].image.largeThumbnailUrl}
														title={pages[index].image.tooltip} page_id={index} loadallimages={loadallimages} preload_large={false}>
													</thumbcanvas>
												</a>
												<button type="button" class="btn btn-image position-absolute top-0" if={props.showDeletePageButton} onclick={() => askDeletePage(index)}
													aria-label={t('loeschen')}>
													<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('trash')}" /></svg></span>
												</button>
											</div>
											<label-input if={settings.enabled} page={pages[index]} index={index} preview={preview ? preview.result : null}
												own={!!ownFlags[index]} follow={ownFlags[index]} changed={pages[index].label !== pages[index].metsLabel} t={t}
												handle-preview={(text, mode) => previewLabelAt(index, text, mode)} handle-commit={(text, mode) => commitLabel(index, text, mode)}
												handle-cancel={cancelLabel} is-rendering={isRendering} handle-move={delta => moveLabelFocus(index, delta)}></label-input>
										</div>
										<div data-typing-hint class="newspaper-hint" aria-live="polite">{hintFor(row)}</div>
									</div>
								</template>

								<template if={!row.loose}>
									<div class="thumbnail-image px-3 pb-3" id={blockElementId(row.node)}>
										<div class="goobi-thumbnail font-light">
											<div class="goobi-thumbnail-image">
												<div class="thumb position-relative" style="min-height: {thumb_height}px;">
													<a onclick={e => onPageClick(e, row.node.first)}>
														<thumbcanvas key={pages[row.node.first].filename} width={thumb_height} height={thumb_height}
															image_small={pages[row.node.first].image.thumbnailUrl} image_large={pages[row.node.first].image.largeThumbnailUrl}
															title={pages[row.node.first].image.tooltip} page_id={row.node.first} loadallimages={loadallimages} preload_large={true}>
														</thumbcanvas>
													</a>
													<button type="button" class="btn btn-image position-absolute top-0" if={props.showDeletePageButton} onclick={() => askDeletePage(row.node.first)}
														aria-label={t('loeschen')}>
														<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('trash')}" /></svg></span>
													</button>
												</div>
											</div>
										</div>
										<label-input if={settings.enabled} page={pages[row.node.first]} index={row.node.first} preview={preview ? preview.result : null}
											own={!!ownFlags[row.node.first]} follow={ownFlags[row.node.first]} changed={pages[row.node.first].label !== pages[row.node.first].metsLabel} t={t}
											handle-preview={(text, mode) => previewLabelAt(row.node.first, text, mode)} handle-commit={(text, mode) => commitLabel(row.node.first, text, mode)}
											handle-cancel={cancelLabel} is-rendering={isRendering} handle-move={delta => moveLabelFocus(row.node.first, delta)}></label-input>
									</div>

									<div class="issue-controls d-flex flex-column gap-3 px-3 pb-3" style="min-height: {thumb_height}px;">
										<block-fields
											start={row.node.start}
											info={catalog[row.node.start.type]}
											type-options={typeOptions(volumeType)}
											flags={flagsFor(row.node)}
											t={t}
											date-format-pattern={dateFormatPattern}
											handle-type={type => changeType(row.node, type)}
											handle-date={value => changeDate(row.node, value)}
											handle-field={(name, value) => changeField(row.node, name, value)}
											fields={fieldsOf(row.node)}
											handle-value={(key, value) => changeValue(row.node, key, value)}
											handle-reset={key => resetValue(row.node, key)}
											handle-keep={key => keepValue(row.node, key)}
											hidden-open={openHidden === blockElementId(row.node)}
											handle-toggle-hidden={() => toggleHidden(blockElementId(row.node))}
											handle-remove-hidden={() => askRemoveHidden(row.node)}
											handle-pattern={() => openDialog('pattern', row.node)}
											handle-continue={isGeneratable(row.node) ? () => openDialog('continue', row.node) : null}
											allow-loose={true}
											page-first={row.node.first + 1}
											page-last={row.node.last + 1}></block-fields>

										<div if={row.node.children.length > 0} class="block-tree">
										<div each={(child, childIndex) in row.node.children} class="block-tree__item" id={blockElementId(child)}>
											<block-fields
												start={child.start}
												info={catalog[child.start.type]}
												type-options={typeOptions(row.node.start.type)}
												flags={flagsFor(child)}
												t={t}
												date-format-pattern={dateFormatPattern}
												handle-type={type => changeType(child, type)}
												handle-date={value => changeDate(child, value)}
												handle-field={(name, value) => changeField(child, name, value)}
												fields={fieldsOf(child)}
												handle-value={(key, value) => changeValue(child, key, value)}
												handle-reset={key => resetValue(child, key)}
												handle-keep={key => keepValue(child, key)}
												hidden-open={openHidden === blockElementId(child)}
												handle-toggle-hidden={() => toggleHidden(blockElementId(child))}
												handle-remove-hidden={() => askRemoveHidden(child)}
												color={childColor(childIndex + 1)}></block-fields>
										</div>
										</div>

									</div>

									<div class="thumbnails px-3 pb-3" style="--thumb-size: {thumb_height / 2.5}px;">
										<div each={entry in pagesOf(row.node)} key={pages[entry.index].filename + ':' + entry.child} class="newspaper-thumbnail">
											<div class="newspaper-thumbnail__image position-relative" style="min-height: {thumb_height / 2}px;">
												<a onclick={e => onPageClick(e, entry.index)}>
													<thumbcanvas width={thumb_height / 2} height={thumb_height / 2}
														render_text={entry.child || null} render_size="24" render_bg_color={entry.child ? childColor(entry.child) : null}
														image_small={pages[entry.index].image.thumbnailUrl} image_large={pages[entry.index].image.largeThumbnailUrl}
														title={pages[entry.index].image.tooltip} page_id={entry.index} loadallimages={loadallimages} preload_large={false}>
													</thumbcanvas>
												</a>
												<button type="button" class="btn btn-image position-absolute top-0" if={props.showDeletePageButton} onclick={() => askDeletePage(entry.index)}
													aria-label={t('loeschen')}>
													<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('trash')}" /></svg></span>
												</button>
											</div>
												<label-input if={settings.enabled} page={pages[entry.index]} index={entry.index} preview={preview ? preview.result : null}
													own={!!ownFlags[entry.index]} follow={ownFlags[entry.index]} changed={pages[entry.index].label !== pages[entry.index].metsLabel} t={t}
													handle-preview={(text, mode) => previewLabelAt(entry.index, text, mode)} handle-commit={(text, mode) => commitLabel(entry.index, text, mode)}
													handle-cancel={cancelLabel} is-rendering={isRendering} handle-move={delta => moveLabelFocus(entry.index, delta)}></label-input>
										</div>
										<div data-typing-hint class="newspaper-hint" aria-live="polite">{hintFor(row)}</div>
										<div if={offerFor(row)} data-offer class="newspaper-offer">
											<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('list-numbers')}" /></svg></span>
											<span>{offerText(row)}</span>
											<button type="button" data-offer-accept class="btn btn-primary btn-sm" onclick={() => acceptOffer(row.node.first)}>{offerButton(row)}</button>
											<button type="button" data-offer-dismiss class="btn btn-blank btn-sm p-0 px-1" onclick={() => dismissOffer(row.node.first)}
												title={t('plugin_newspaperRecognizer_pagination_offer_dismiss')} aria-label={t('plugin_newspaperRecognizer_pagination_offer_dismiss')}>
												<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('x')}" /></svg></span>
											</button>
										</div>
									</div>
								</template>
							</template>
						</div>
					</div>
				</template>
			</div>

		</div>
	</div>

<type-pattern-dialog if={dialog && dialog.kind === 'pattern'} pages={pages} start-ref={dialog.ref} catalog={catalog}
		type-options={dialog.typeOptions} t={t} handle-apply={applyPattern} handle-cancel={closeDialog}></type-pattern-dialog>
	<continue-dialog if={dialog && dialog.kind === 'continue'} pages={pages} start-ref={dialog.ref} catalog={catalog}
		type-options={dialog.typeOptions} t={t} date-format-pattern={dateFormatPattern}
		handle-apply={applyGenerated} handle-cancel={closeDialog}></continue-dialog>
	<conflict-dialog if={pendingChange} conflicts={pendingChange.conflicts} total={pendingChange.options.total} catalog={catalog} t={t}
		handle-confirm={resolveConflicts} handle-cancel={cancelConflicts}></conflict-dialog>

	<plugin-modal if={confirmation} title={t(confirmation.title)} close-label={t('cancel')} handle-close={cancelConfirmation}>
		<p class="mb-0">{t(confirmation.text)}</p>
		<template slot="footer">
			<button type="button" class="btn btn-blank" onclick={cancelConfirmation}>{t('abbrechen')}</button>
			<button type="button" class="btn btn-danger" onclick={runConfirmation}>
				<span if={confirmation.icon} aria-hidden="true" class="icon-wrapper me-2"><svg><use href="{GoobiIcons.iconHref(confirmation.icon)}" /></svg></span>
				<span>{t(confirmation.button)}</span>
			</button>
		</template>
	</plugin-modal>

	<script>
	import Thumbcanvas from './thumbcanvas.riot'
	import BlockFields from './block-fields.riot'
	import HiddenPopover from './hidden-popover.riot'
	import ConflictDialog from './conflict-dialog.riot'
	import PluginModal from './plugin-modal.riot'
	import LabelInput from './label-input.riot'
	import {
		buildTree, flatten, refOf, toggleBlock, toggleChild, setType, setDateInput, initStarts, validateBlocks,
		removeAllBlocks, resetToAnalysis, removePage, shiftStructures, toSaveRequest, clonePages, siblingsFrom, syncDateInputs,
		canMerge, makeLoose,
	} from '../logic/blocks.mjs'
	import { initLabels, structureChanged, paginateBlock } from '../logic/pagination.mjs'
	import { previewLabel, ownNumberingAll } from '../logic/typing.mjs'
	import { parseLabel, isCounting } from '../logic/labels.mjs'
	import TypePatternDialog from './type-pattern-dialog.riot'
	import ContinueDialog from './continue-dialog.riot'
	import { applyTypePattern } from '../logic/generation.mjs'
	import { fieldStates, initFieldStates, keepFieldValue, resetFieldValue, setFieldValue } from '../logic/fields.mjs'
	import { positionColor } from '../logic/colors.mjs'
	import { findConflicts, applyResolution, upsertOperation, hasHidden, explicitConflict } from '../logic/hidden.mjs'


	export default {
		components: { Thumbcanvas, BlockFields, HiddenPopover, ConflictDialog, TypePatternDialog, ContinueDialog, PluginModal, LabelInput },

		onBeforeMount(props) {
			// fields of props are defined in plugin_newspaperRecognizer.xhtml
			this.data_el = props.data_el;
			this.saveButton = props.saveButton;
			this.saveResultEl = props.saveResultEl;
			this.finish_button = props.finishButton;
			this.restartAnalysisButton = props.restartAnalysisButton;
			this.delete_file_button = props.deleteFileButton;
			this.thumb_height = props.thumbHeight;
			this.loadallimages = props.loadallimages;
			this.dateFormatPattern = props.dateFormatPattern;
			this.volumeType = props.volumeType;
			this.preventDuplicates = props.preventDuplicates;
			this.configErrors = props.configErrors || [];
			this.catalog = Object.fromEntries((props.typeCatalog || []).map(type => [type.name, type]));
			const pagination = props.pagination;
			this.settings = {
				enabled: !!(pagination && pagination.enabled),
				automatic: !pagination || pagination.automatic !== false,
				withoutBlock: pagination && pagination.withoutBlock && pagination.withoutBlock.length ? pagination.withoutBlock : ['–'],
				rules: (pagination && pagination.rules) || {},
			};
			this.last = null; // {text, undoable}: what just happened, shown in the help line
			this.helpHidden = false;

			this.msgs = {};
			this.dataDirty = false; // true after any change, cleared only when the backend confirms a write
			this.pendingExit = false; // set by saveAndExit, acted upon once the backend confirms the write
			this.saveInFlight = false; // true while a save request is on its way; blocks everything that would abort it
			this.confirmation = null;
			this.openHidden = null; // element id of the block whose hidden data is listed, or 'volume'
			this.pendingChange = null; // a change waiting for the user's decision about hidden data
			this.hiddenCursor = -1;
			this.actionsOpen = false;
			this.dialog = null; // {kind: 'pattern' | 'continue', ref, typeOptions}
			this.loadData(JSON.parse(this.data_el.value));

			var path = window.location.pathname;
			path = path.substring(0, path.indexOf("/uii/"));
			fetch(`${path}/api/messages/${props.language}`, {
				method: 'GET',
				credentials: 'same-origin'
			}).then(resp => {
				resp.json().then(json => {
					for (let key of Object.keys(json)) {
						this.msgs[key] = json[key].replace(" zzz", "");
					}
					this.msgsLoaded = true;
					this.update();
				})
			});
		},

		onMounted(props) {
			this.addAjaxEvent();
			// close the actions menu on a click outside of it or on Escape
			document.addEventListener('click', e => {
				if (this.actionsOpen && !e.target.closest('.dropdown-menu') && !e.target.closest('[aria-haspopup]')) {
					this.actionsOpen = false;
					this.update();
				}
			});
			document.addEventListener('keydown', e => {
				if (this.actionsOpen && e.key === 'Escape') {
					this.actionsOpen = false;
					this.update();
				}
			});
			if (this.loadallimages) {
				this.loadedImages = 0;
				window.npImages = {};
				for (const page of this.pages) {
					const image = new Image();
					image.onload = () => {
						window.npImages[page.image.thumbnailUrl] = image;
					};
					image.src = page.image.thumbnailUrl;
				}
				this.downloadChecker = setInterval(() => {
					this.loadedImages = Object.keys(window.npImages).length;
					if (this.loadedImages == this.pages.length) {
						setTimeout(() => {
							this.imagesLoaded = true;
							clearInterval(this.downloadChecker);
							this.update();
						}, 100);
					}
					this.update();
				}, 500);
			} else {
				this.imagesLoaded = true;
				this.update();
			}
		},

		/* replace the whole state with what the backend sent */
		loadData(data) {
			this.pages = data.pages || [];
			this.notices = data.notices || [];
			this.volumeHidden = data.volumeHidden || { structures: [], metadata: [] };
			this.operations = [];
			for (const page of this.pages) {
				if (page.image) {
					page.image.thumbnailUrl = this.toSameOriginUrl(page.image.thumbnailUrl);
					page.image.largeThumbnailUrl = this.toSameOriginUrl(page.image.largeThumbnailUrl);
				}
			}
			initStarts(this.pages, this.dateFormatPattern);
			initFieldStates(this.pages, this.catalog);
			initLabels(this.pages);
			this.offers = []; // {first, pages, signature}: blocks that offer "Neu nach Regeln"
			this.preview = null; // {index, text, mode, result}: the label being typed
			this.refresh();
		},

		refresh() {
			this.tree = buildTree(this.pages);
			this.validation = validateBlocks(this.pages, this.catalog, this.volumeType, this.preventDuplicates);
			this.flags = this.indexFlags(this.validation);
			this.rows = this.buildRows(this.tree);
			this.ownFlags = this.settings.enabled ? ownNumberingAll(this.pages, this.settings) : []; // per page the follow value of own numbering, else null
		},

		/* level-0 blocks and runs of pages without structure, in page order */
		buildRows(tree) {
			const rows = [];
			let next = 0;
			for (let i = 0; i < this.pages.length;) {
				const root = tree.roots[next];
				if (root && root.first === i) {
					rows.push({ loose: false, node: root });
					i = root.last + 1;
					next++;
				} else {
					const run = [];
					while (i < this.pages.length && !(tree.roots[next] && tree.roots[next].first === i)) {
						run.push(i++);
					}
					rows.push({ loose: true, pages: run });
				}
			}
			return rows;
		},

		indexFlags(validation) {
			const flags = {};
			const mark = (refs, name) => refs.forEach(ref => {
				const key = `${ref.page}:${ref.level}`;
				flags[key] = flags[key] || {};
				flags[key][name] = true;
			});
			mark(validation.missingType, 'missingType');
			mark(validation.notAllowed, 'notAllowed');
			mark(validation.invalidDate, 'invalidDate');
			mark(validation.missingRequired, 'missingRequired');
			mark(validation.duplicates, 'duplicate');
			return flags;
		},

		flagsFor(node) {
			const flags = { ...(this.flags[`${node.first}:${node.level}`] || {}) };
			const info = this.catalog[node.start.type] || {};
			flags.missingDate = flags.missingRequired && info.dated && info.dateRequired && !node.start.date && !node.start.dateRaw;
			flags.missingNumber = flags.missingRequired && info.numbered && info.numberRequired && !(node.start.number || '').trim();
			return flags;
		},

		validationProblems() {
			return [
				['missingType', 'plugin_newspaperRecognizer_validation_summary_missingType'],
				['notAllowed', 'plugin_newspaperRecognizer_validation_summary_notAllowed'],
				['invalidDate', 'plugin_newspaperRecognizer_validation_summary_invalidDate'],
				['missingRequired', 'plugin_newspaperRecognizer_validation_summary_missingRequired'],
				['duplicates', 'plugin_newspaperRecognizer_validation_summary_duplicates'],
			].filter(([name]) => this.validation[name].length > 0)
				.map(([name, key]) => ({ name, key, count: new Set(this.validation[name].map(ref => `${ref.page}:${ref.level}`)).size }));
		},

		/* scrolls to the next block with this problem (cycling) and puts the cursor into its type drop-down */
		jumpToProblem(name) {
			const refs = [...new Map(this.validation[name].map(ref => [`${ref.page}:${ref.level}`, ref])).values()];
			if (refs.length === 0) {
				return;
			}
			this.problemCursor = this.problemCursor || {};
			const next = ((this.problemCursor[name] ?? -1) + 1) % refs.length;
			this.problemCursor[name] = next;
			const ref = refs[next];
			const element = document.getElementById(this.blockElementId({ first: ref.page, level: ref.level }));
			if (element) {
				element.scrollIntoView({ behavior: 'smooth', block: 'center' });
				const select = (ref.level === 0 ? element.nextElementSibling : element).querySelector('select');
				if (select) {
					select.focus({ preventScroll: true });
				}
			}
		},


		typeOptions(parentType) {
			return ((this.catalog[parentType] || {}).children || []).map(name => ({ name, label: (this.catalog[name] || {}).label || name }));
		},

		childColor(number) {
			return positionColor(number - 1);
		},

		blockElementId(node) {
			return `block-${node.first}-${node.level}`;
		},

		/* the pages of a block after its first page, with the number of the child block they belong to (0 = none) */
		pagesOf(node) {
			const result = [];
			for (let i = node.first + 1; i <= node.last; i++) {
				const child = node.children.findIndex(c => c.first <= i && i <= c.last);
				result.push({ index: i, child: child + 1 });
			}
			return result;
		},

		pagesSummary(first, last) {
			if (first === last) {
				return this.t('plugin_newspaperRecognizer_pagesSummarySingle').replace('{0}', first);
			}
			return this.t('plugin_newspaperRecognizer_pagesSummary').replace('{0}', last - first + 1).replace('{1}', first).replace('{2}', last);
		},

		t(key) {
			return key in this.msgs ? this.msgs[key] : key;
		},

		formatNotice(notice) {
			return this.t(notice.key).replace(/\{(\d+)\}/g, (match, i) => (notice.params && notice.params[i] !== undefined ? notice.params[i] : match));
		},

		/* the single entry point for every change of the page list: asks about hidden data before committing */
		applyChange(newPages, options = {}) {
			if (this.sameState(this.pages, newPages)) {
				return; // nothing changed: no dirty state, no step, no message
			}
			const conflicts = findConflicts(this.pages, newPages, this.catalog, this.volumeType);
			if (conflicts.length === 0) {
				this.commit(newPages, options.step);
				if (options.afterCommit) {
					options.afterCommit();
				}
				return;
			}
			this.pendingChange = { pages: newPages, conflicts, options };
			this.update();
		},

		sameState(before, after) {
			const plain = pages => JSON.stringify(pages.map(({ depth, label, starts }) => [depth, label, starts]));
			return before.length === after.length && plain(before) === plain(after);
		},

		/* step: {text, paginate}; a structure change paginates what it needs (unless paginate is false), then says what happened */
		commit(newPages, step = {}) {
			let pages = newPages;
			const parts = step.text ? [step.text] : [];
			let offers = [];
			if (this.settings.enabled && step.paginate !== false) {
				const result = structureChanged(this.pages, newPages, this.settings);
				pages = result.pages;
				offers = result.offers;
				parts.push(this.paginationInfo(result));
			}
			this.pages = pages;
			this.dataDirty = true;
			this.refresh();
			this.offers = this.keepOffers(offers);
			if (parts.length > 0) {
				this.last = { text: parts.join(' · '), undoable: true };
			}
			this.updateKeepingFocus();
		},

		/* Riot may re-insert the nodes of a block while it updates, which takes the focus from a field the user is typing in; blur is
		   no decision then (see isRendering) and the field gets its focus and cursor back */
		updateKeepingFocus() {
			const field = document.activeElement;
			const keep = field && field.matches && field.matches('input, textarea, select') && field.isConnected ? field : null;
			const selection = keep && typeof keep.selectionStart === 'number' ? [keep.selectionStart, keep.selectionEnd] : null;
			this.rendering = true;
			try {
				this.update();
			} finally {
				this.rendering = false;
			}
			if (keep && keep.isConnected && document.activeElement !== keep) {
				keep.focus({ preventScroll: true });
				if (selection) {
					keep.setSelectionRange(selection[0], selection[1]);
				}
			}
		},

		isRendering() {
			return !!this.rendering;
		},

		paginationInfo(result) {
			let text;
			if (this.settings.automatic === false) {
				text = this.t('plugin_newspaperRecognizer_pagination_autoOff');
			} else if (result.changed.length > 0) {
				text = this.fmt('plugin_newspaperRecognizer_pagination_adjusted', this.pagesText(result.changed));
			} else {
				text = this.t('plugin_newspaperRecognizer_pagination_unchanged');
			}
			if (result.offers.length > 0) {
				text += ' · ' + (result.offers.length === 1 ? this.t('plugin_newspaperRecognizer_pagination_offerBlock')
					: this.fmt('plugin_newspaperRecognizer_pagination_offerBlocks', result.offers.length));
			}
			return text;
		},

		/* "Seite 5", "Seiten 5–6, 9" from page indexes */
		pagesText(indexes) {
			const ranges = [];
			for (const i of indexes) {
				const last = ranges[ranges.length - 1];
				if (last && last[1] === i - 1) {
					last[1] = i;
				} else {
					ranges.push([i, i]);
				}
			}
			const text = ranges.map(([from, to]) => (from === to ? `${from + 1}` : `${from + 1}–${to + 1}`)).join(', ');
			return this.fmt(indexes.length === 1 ? 'plugin_newspaperRecognizer_pagination_pageOne' : 'plugin_newspaperRecognizer_pagination_pagesMany', text);
		},

		fmt(key, ...args) {
			return this.t(key).replace(/\{(\d+)\}/g, (match, i) => (args[i] !== undefined ? args[i] : match));
		},

		/* an offer belongs to its block as it is: another structure change or label in the block makes it disappear */
		offerSignature(first) {
			const node = this.tree.roots.find(root => root.first === first);
			if (!node) {
				return null;
			}
			return JSON.stringify([node.last, node.start.type, this.pages.slice(node.first, node.last + 1).map(page => [page.label, page.depth])]);
		},

		keepOffers(fresh) {
			const offers = fresh.map(offer => ({ ...offer, signature: this.offerSignature(offer.first) }));
			for (const offer of this.offers) {
				if (!offers.some(o => o.first === offer.first) && offer.signature === this.offerSignature(offer.first)) {
					offers.push(offer);
				}
			}
			return offers;
		},

		offerFor(row) {
			return !row.loose && this.settings.enabled && this.offers.find(offer => offer.first === row.node.first) || null;
		},

		offerText(row) {
			const offer = this.offerFor(row);
			return this.fmt(offer.pages.length === 1 ? 'plugin_newspaperRecognizer_pagination_offerTextOne' : 'plugin_newspaperRecognizer_pagination_offerText',
				this.pagesText(offer.pages));
		},

		offerButton(row) {
			const count = this.offerFor(row).pages.length;
			return this.fmt(count === 1 ? 'plugin_newspaperRecognizer_pagination_offerAcceptOne' : 'plugin_newspaperRecognizer_pagination_offerAccept', count);
		},

		acceptOffer(first) {
			const offer = this.offers.find(o => o.first === first);
			if (!offer) {
				return;
			}
			const fresh = paginateBlock(this.pages, this.settings, first);
			const pages = clonePages(this.pages);
			offer.pages.forEach(i => { pages[i].label = fresh[i].label; });
			this.commit(pages, { text: this.fmt('plugin_newspaperRecognizer_pagination_step_offer', this.pagesText(offer.pages)), paginate: false });
		},

		dismissOffer(first) {
			this.offers = this.offers.filter(offer => offer.first !== first);
			this.update();
		},

		hideHelp() {
			this.helpHidden = true;
			this.update();
		},

		/* a message in the help line without a change of the state */
		say(text) {
			this.last = { text, undoable: false };
			this.update();
		},

		previewLabelAt(index, text, mode) {
			this.preview = { index, text, mode, result: previewLabel(this.pages, this.settings, index, text, mode) };
			this.updateKeepingFocus();
		},

		cancelLabel() {
			if (this.preview) {
				this.preview = null;
				this.updateKeepingFocus();
			}
		},

		commitLabel(index, text, mode) {
			const result = previewLabel(this.pages, this.settings, index, text, mode);
			this.preview = null;
			const changes = result.pages.map((page, i) => i).filter(i => result.pages[i].label !== this.pages[i].label);
			if (changes.length === 0) {
				this.updateKeepingFocus();
				return;
			}
			const following = changes.filter(i => i !== index).length;
			let step = parseLabel(text).kind === 'empty'
				? this.fmt('plugin_newspaperRecognizer_pagination_step_labelFollow', index + 1, result.value)
				: this.fmt('plugin_newspaperRecognizer_pagination_step_label', index + 1, result.value);
			if (following > 0) {
				step += ' · ' + this.fmt(following === 1 ? 'plugin_newspaperRecognizer_pagination_step_runOne' : 'plugin_newspaperRecognizer_pagination_step_runMany', following);
			}
			this.commit(result.pages, { text: step, paginate: false });
		},

		/* true if there is a label field to go to */
		moveLabelFocus(index, delta) {
			const field = this.$(`[data-label-input="${index + delta + 1}"]`);
			if (field) {
				field.focus();
			}
			return !!field;
		},

		/* what is recognised and what follows while a label is typed; shown under the block of the page */
		hintFor(row) {
			const typed = this.preview;
			if (!typed || !(row.loose ? row.pages.includes(typed.index) : typed.index >= row.node.first && typed.index <= row.node.last)) {
				return '';
			}
			const result = typed.result;
			const key = name => `plugin_newspaperRecognizer_pagination_hint_${name}`;
			const changing = result.run.filter(i => result.pages[i].label !== this.pages[i].label);
			const run = changing.length === 0 ? '' : this.fmt(changing.length === 1 ? key('runOne') : key('runMany'), changing.length, changing[changing.length - 1] + 1);
			let text;
			if (result.kind === 'empty') {
				text = this.fmt(key('follow'), result.value) + (run ? ' · ' + run : '');
			} else if (!isCounting(result.value)) {
				const kind = this.t(key(result.kind === 'none' ? 'none' : 'text'));
				text = this.fmt(key('recognized'), kind) + ' · ' + this.t(key('single'));
			} else {
				const parsed = parseLabel(result.value);
				const kind = this.t(key(parsed.kind)) + (parsed.fictitious ? this.t(key('fictitious')) : '');
				text = this.fmt(key('recognized'), kind) + ' · ' + (run || this.t(result.run.length > 0 ? key('noChange') : key('runNone')));
				if (result.stop !== null && isCounting(this.pages[result.stop].label)) {
					text += ' · ' + this.fmt(key('stop'), result.stop + 1);
				} else if (result.stop === null && changing.length > 0) {
					text += ' · ' + this.t(key('toEnd'));
				}
			}
			return text + ' · ' + this.t(key('keys'));
		},

		resolveConflicts(choices) {
			const { pages, conflicts, options } = this.pendingChange;
			this.pendingChange = null;
			for (const conflict of conflicts) {
				const action = choices[conflict.kind];
				const { volumeAdditions } = applyResolution(pages, conflict, action, this.catalog, this.volumeType);
				this.volumeHidden.structures.push(...volumeAdditions);
				this.operations = upsertOperation(this.operations, conflict.blockId, conflict.kind, action);
			}
			this.commit(pages, options.step);
			if (options.afterCommit) {
				options.afterCommit();
			}
		},

		cancelConflicts() {
			this.pendingChange = null;
			this.update();
		},

		otherNotices() {
			// the notice about structures of the volume is part of the additional data notice
			return this.notices.filter(n => n.key !== 'plugin_newspaperRecognizer_notice_volumeHidden');
		},

		toggleActions() {
			if (this.saveInFlight) {
				return;
			}
			this.actionsOpen = !this.actionsOpen;
			this.update();
		},

		runAction(action) {
			this.actionsOpen = false;
			action();
		},

		toggleHidden(key) {
			this.openHidden = this.openHidden === key ? null : key;
			this.update();
		},

		askRemoveHidden(node) {
			this.openHidden = null;
			this.askConfirmation('plugin_newspaperRecognizer_hidden_remove', 'plugin_newspaperRecognizer_hidden_confirmRemove',
				'plugin_newspaperRecognizer_hidden_remove', () => {
					const pages = clonePages(this.pages);
					applyResolution(pages, explicitConflict(node.start, node.first), 'REMOVE_ALL', this.catalog, this.volumeType);
					this.operations = upsertOperation(this.operations, node.start.id, 'EXPLICIT', 'REMOVE_ALL');
					this.commit(pages, { text: this.t('plugin_newspaperRecognizer_pagination_step_hidden'), paginate: false });
				}, 'trash');
		},

		hiddenBlocks() {
			return flatten(this.tree.roots).filter(node => hasHidden(node.start));
		},

		jumpToNextHidden() {
			const blocks = this.hiddenBlocks();
			if (blocks.length === 0) {
				return;
			}
			this.hiddenCursor = (this.hiddenCursor + 1) % blocks.length;
			const element = document.getElementById(this.blockElementId(blocks[this.hiddenCursor]));
			if (element) {
				element.scrollIntoView({ behavior: 'smooth', block: 'center' });
			}
		},

		isGeneratable(node) {
			const info = this.catalog[node.start.type] || {};
			return !!(info.dated || info.numbered);
		},

		openDialog(kind, node) {
			this.dialog = { kind, ref: refOf(node), typeOptions: this.typeOptions(node.parent ? node.parent.start.type : this.volumeType) };
			this.update();
		},

		closeDialog() {
			this.dialog = null;
			this.update();
		},

		applyPattern(pattern) {
			const ref = this.dialog.ref;
			this.dialog = null;
			const total = siblingsFrom(this.tree, ref).length;
			this.applyChange(applyTypePattern(this.pages, ref, pattern, this.catalog), { bulk: true, total, step: { text: this.t('plugin_newspaperRecognizer_pagination_step_pattern') } });
		},

		applyGenerated(newPages) {
			this.dialog = null;
			syncDateInputs(newPages, this.dateFormatPattern);
			this.applyChange(newPages, { bulk: true, step: { text: this.t('plugin_newspaperRecognizer_pagination_step_generated') } });
		},

		onPageClick(e, index) {
			if (e.shiftKey || this.saveInFlight) {
				return; // shift is used for zooming
			}
			const number = index + 1;
			if (e.altKey || e.ctrlKey) {
				this.applyChange(toggleChild(this.pages, index, this.catalog), { bulk: false, step: { text: this.fmt('plugin_newspaperRecognizer_pagination_step_supplement', number) } });
				return;
			}
			const blockStart = this.tree.roots.some(root => root.first === index);
			if (blockStart && !canMerge(this.pages, index)) {
				this.say(this.fmt('plugin_newspaperRecognizer_pagination_step_cannotMerge', number)); // no change, so no step to undo
				return;
			}
			this.applyChange(toggleBlock(this.pages, index), { bulk: false, step: { text: this.fmt(blockStart ? 'plugin_newspaperRecognizer_pagination_step_merge' : 'plugin_newspaperRecognizer_pagination_step_newBlock', number) } });
		},

		changeType(node, type) {
			if (type === '__loose__') {
				this.applyChange(makeLoose(this.pages, node.first), { bulk: false, step: { text: this.fmt('plugin_newspaperRecognizer_pagination_step_loose', node.first + 1) } });
				return;
			}
			this.applyChange(setType(this.pages, refOf(node), type, this.catalog), { bulk: false, step: { text: this.fmt('plugin_newspaperRecognizer_pagination_step_type', node.first + 1) } });
		},

		changeDate(node, value) {
			setDateInput(node.start, value, this.dateFormatPattern);
			this.dataDirty = true;
			this.refresh();
			this.updateKeepingFocus();
		},

		changeField(node, name, value) {
			node.start[name] = value === '' ? null : value;
			this.dataDirty = true;
			this.refresh();
			this.updateKeepingFocus();
		},

		changeValue(node, key, value) {
			setFieldValue(node, key, value, this.catalog);
			this.dataDirty = true;
			this.refresh();
			this.updateKeepingFocus();
		},

		fieldsOf(node) {
			return fieldStates(node, this.catalog);
		},

		resetValue(node, key) {
			resetFieldValue(node.start, key);
			this.dataDirty = true;
			this.refresh();
			this.update();
		},

		keepValue(node, key) {
			keepFieldValue(node, key, this.catalog);
			this.refresh();
			this.update();
		},

		/* every confirmation guards a destructive action; icon is optional (e.g. 'trash') */
		askConfirmation(title, text, button, action, icon) {
			this.confirmation = { title, text, button, action, icon };
			this.update();
		},

		cancelConfirmation() {
			this.confirmation = null;
			this.openHidden = null; // element id of the block whose hidden data is listed, or 'volume'
			this.pendingChange = null; // a change waiting for the user's decision about hidden data
			this.hiddenCursor = -1;
			this.dialog = null; // {kind: 'pattern' | 'continue', ref, typeOptions}
			this.update();
		},

		runConfirmation() {
			const action = this.confirmation.action;
			this.confirmation = null;
			this.openHidden = null; // element id of the block whose hidden data is listed, or 'volume'
			this.pendingChange = null; // a change waiting for the user's decision about hidden data
			this.hiddenCursor = -1;
			this.dialog = null; // {kind: 'pattern' | 'continue', ref, typeOptions}
			this.update();
			action();
		},

		askResetToAnalysis() {
			this.askConfirmation('plugin_newspaperRecognizer_action_takeAnalysis', 'plugin_newspaperRecognizer_confirmResetToAnalysis',
				'plugin_newspaperRecognizer_action_takeAnalysis', () => this.applyChange(resetToAnalysis(this.pages), { bulk: true, total: flatten(this.tree.roots).length, step: { text: this.t('plugin_newspaperRecognizer_pagination_step_resetToAnalysis') } }));
		},

		askRemoveAllBlocks() {
			this.askConfirmation('plugin_newspaperRecognizer_removeAllBlocks', 'plugin_newspaperRecognizer_confirmAction',
				'plugin_newspaperRecognizer_removeAllBlocks', () => this.applyChange(removeAllBlocks(this.pages), { bulk: true, total: flatten(this.tree.roots).length, step: { text: this.t('plugin_newspaperRecognizer_pagination_step_removeAll') } }), 'trash');
		},

		askRecompute() {
			this.askConfirmation('plugin_newspaperRecognizer_action_restartAnalysis', 'plugin_newspaperRecognizer_confirmRecompute',
				'plugin_newspaperRecognizer_action_restartAnalysis', () => this.restartAnalysisButton.click());
		},

		askDeletePage(index) {
			if (this.saveInFlight) {
				return;
			}
			this.askConfirmation('loeschen', 'plugin_newspaperRecognizer_confirmDeleteImage', 'loeschen', () => this.deletePage(index), 'trash');
		},

		/* once the change is accepted (Task 16 may ask about hidden data first): delete the image and save right away */
		deletePage(index) {
			const page = this.pages[index];
			this.applyChange(removePage(this.pages, index), {
				bulk: false,
				step: { text: this.fmt('plugin_newspaperRecognizer_pagination_step_deleteImage', index + 1), paginate: false }, // deleting an image changes no other label
				afterCommit: () => {
					shiftStructures(this.volumeHidden.structures, index);
					document.getElementById('delete_form:file_name_to_delete').value = page.filename;
					document.getElementById('delete_form:file_id_to_delete').value = index;
					this.delete_file_button.click();
					this.save();
				},
			});
		},

		addAjaxEvent() {
			faces.ajax.addOnEvent((data) => {
				var ajaxloader = this.$("#ajaxloaderbottom");
				var isSaveRequest = this.isSaveRequest(data);
				switch (data.status) {
					case "begin":
						if (ajaxloader) {
							ajaxloader.style.display = 'inline';
						}
						break;
					case "complete":
						if (ajaxloader) {
							ajaxloader.style.display = 'none';
						}
						if (isSaveRequest) {
							// the request has been answered, whatever its outcome: allow interaction again
							this.saveInFlight = false;
							this.update();
						}
						break;
					case "success":
						if (isSaveRequest) {
							this.applySaveResult();
						}
						break;
				}
			});
			// a save request that never reached the backend must leave the data dirty, so it can be sent again
			faces.ajax.addOnError((data) => {
				if (this.isSaveRequest(data)) {
					this.saveInFlight = false;
					this.pendingExit = false;
					this.update();
				}
			});
		},

		/* faces.js resolves the source element by id, so compare ids instead of node identity */
		isSaveRequest(data) {
			return !!data.source && !!this.saveButton && data.source.id === this.saveButton.id;
		},

		/* the partial response replaces the elements, so re-resolve them by id instead of reading detached nodes */
		readSaveResult() {
			if (!this.saveResultEl) {
				return '';
			}
			var el = document.getElementById(this.saveResultEl.id) || this.saveResultEl;
			return el.textContent.trim();
		},

		/* only a confirmed write means the data is persisted; then take over the freshly read state (new ids, hidden data) */
		applySaveResult() {
			if (this.readSaveResult() !== 'SUCCESS') {
				this.pendingExit = false;
				this.update();
				return;
			}
			this.data_el = document.getElementById(this.data_el.id) || this.data_el;
			this.dataDirty = false;
			this.loadData(JSON.parse(this.data_el.value));
			this.update();
			if (this.pendingExit) {
				this.pendingExit = false;
				this.finish_button.click();
			}
		},

		canSave() {
			if (this.saveInFlight || !(this.dataDirty || this.hasOpenEdit()) || this.configErrors.length > 0) {
				return false;
			}
			return this.validation.valid;
		},

		/* a label typed but not yet committed that would change something */
		hasOpenEdit() {
			return !!this.preview && this.preview.result.pages.some((page, i) => page.label !== this.pages[i].label);
		},

		/* the edit in the open label field belongs to what is saved */
		commitOpenEdit() {
			if (this.preview) {
				this.commitLabel(this.preview.index, this.preview.text, this.preview.mode);
			}
		},

		save() {
			this.commitOpenEdit();
			if (!this.canSave()) {
				return;
			}
			this.saveInFlight = true;
			this.data_el.value = toSaveRequest(this.pages, this.operations, this.catalog);
			this.saveButton.click();
			this.update();
		},

		saveAndExit() {
			if (this.saveInFlight) {
				return;
			}
			this.commitOpenEdit();
			if (!this.dataDirty) {
				this.finish_button.click();
				return;
			}
			if (!this.canSave()) {
				return;
			}
			this.pendingExit = true;
			this.save();
		},

		exit() {
			if (this.saveInFlight) {
				return;
			}
			if (this.dataDirty) {
				this.askConfirmation('pluginLeave', 'plugin_newspaperRecognizer_confirmLeaveUnsaved', 'pluginLeave', () => this.finish_button.click());
				return;
			}
			this.finish_button.click();
		},

		/* the backend may report the wrong scheme (e.g. http behind an https reverse proxy), which the img-src 'self' CSP then
		   blocks as cross-origin. Stripping scheme/host/port avoids that regardless of proxy config. */
		toSameOriginUrl(url) {
			if (!url) {
				return url;
			}
			try {
				const parsed = new URL(url, window.location.href);
				if (parsed.hostname !== window.location.hostname) {
					return url;
				}
				return parsed.pathname + parsed.search + parsed.hash;
			} catch (e) {
				return url;
			}
		},
	}
	</script>
</app>
