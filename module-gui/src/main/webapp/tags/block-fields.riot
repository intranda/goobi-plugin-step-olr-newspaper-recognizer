<block-fields>
	<div class="d-flex flex-column gap-2">
		<!-- type, hidden data and tools share one input group, so they line up with the field -->
		<div class="form-group p-0 m-0 {props.flags.missingType || props.flags.notAllowed ? 'has-validation-error' : ''}">
			<div class="input-group flex-nowrap">
				<label class="input-group-text" style={LABEL_STYLE} for={fieldId('type')}>
					<span if={props.color} aria-hidden="true" class="me-2" style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: {props.color};"></span>
					<span if={!props.color} aria-hidden="true" class="icon-wrapper me-2"><svg><use href="{GoobiIcons.iconHref('category')}" /></svg></span>
					{props.t('plugin_newspaperRecognizer_preview_type')}
				</label>
				<select class="form-select" id={fieldId('type')} onchange={e => props.handleType(e.target.value || null)}>
					<option value="" selected={!props.start.type}>{props.t('plugin_newspaperRecognizer_pleaseSelect')}</option>
					<option each={option in props.typeOptions} value={option.name} selected={option.name === props.start.type}>{option.label}</option>
					<hr if={props.allowLoose} />
					<option if={props.allowLoose} value="__loose__">{props.t('plugin_newspaperRecognizer_pagination_withoutBlock')}</option>
				</select>
				<button if={props.handlePattern} type="button" class="btn btn-blank text-nowrap d-flex align-items-center gap-1" onclick={() => props.handlePattern()}
					title={props.t('plugin_newspaperRecognizer_typePattern_title')}>
					<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('repeat')}" /></svg></span>
					<span>{props.t('plugin_newspaperRecognizer_typePattern_short')}</span>
				</button>
			</div>
			<span if={props.flags.missingType} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_missingType')}</span>
			<span if={props.flags.notAllowed} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_notAllowed')}</span>
		</div>

		<div if={props.info && props.info.dated} class="form-group p-0 m-0 {props.flags.invalidDate || props.flags.missingDate || props.flags.duplicate ? 'has-validation-error' : ''}">
			<div class="input-group flex-nowrap">
				<label class="input-group-text" style={LABEL_STYLE} for={fieldId('date')}>
					<span aria-hidden="true" class="icon-wrapper me-2"><svg><use href="{GoobiIcons.iconHref('calendar')}" /></svg></span>
					{props.t('plugin_newspaperRecognizer_date')}{props.info.dateRequired ? ' *' : ''}
				</label>
				<input type="text" class="form-control" id={fieldId('date')} value={props.start.dateInput} placeholder={props.dateFormatPattern}
					onkeyup={e => props.handleDate(e.target.value)} onblur={e => props.handleDate(e.target.value)} />
				<button if={props.handleContinue && true} type="button" class="btn btn-blank text-nowrap d-flex align-items-center gap-1" onclick={() => props.handleContinue()}
					title={props.t('plugin_newspaperRecognizer_continueFromHere')}>
					<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('calendar-plus')}" /></svg></span>
					<span>{props.t('plugin_newspaperRecognizer_continue_short')}</span>
				</button>
			</div>
			<span if={props.flags.invalidDate} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_wrongDateFormat')} {props.dateFormatPattern}</span>
			<span if={props.flags.missingDate} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_missingRequired')}</span>
			<span if={props.flags.duplicate} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_duplicate')}</span>
		</div>

		<div if={props.info && props.info.numbered} class="form-group p-0 m-0 {props.flags.missingNumber ? 'has-validation-error' : ''}">
			<div class="input-group flex-nowrap">
				<label class="input-group-text" style={LABEL_STYLE} for={fieldId('number')}>
					<span aria-hidden="true" class="icon-wrapper me-2"><svg><use href="{GoobiIcons.iconHref('hash')}" /></svg></span>
					{props.t('plugin_newspaperRecognizer_nro')}{props.info.numberRequired ? ' *' : ''}
				</label>
				<input if={props.info.partNumbered} type="text" class="form-control" value={props.start.prefix || ''}
					aria-label={props.t('prefix')} placeholder={props.t('prefix')} onkeyup={e => props.handleField('prefix', e.target.value)} />
				<input type="text" class="form-control" id={fieldId('number')} value={props.start.number || ''}
					onkeyup={e => props.handleField('number', e.target.value)} />
				<input if={props.info.partNumbered} type="text" class="form-control" value={props.start.suffix || ''}
					aria-label={props.t('suffix')} placeholder={props.t('suffix')} onkeyup={e => props.handleField('suffix', e.target.value)} />
				<button if={props.handleContinue && !props.info.dated} type="button" class="btn btn-blank text-nowrap d-flex align-items-center gap-1" onclick={() => props.handleContinue()}
					title={props.t('plugin_newspaperRecognizer_continueFromHere')}>
					<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('calendar-plus')}" /></svg></span>
					<span>{props.t('plugin_newspaperRecognizer_continue_short')}</span>
				</button>
			</div>
			<span if={props.flags.missingNumber} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_missingRequired')}</span>
		</div>
		<!-- the visible metadata fields of the type (plugin configuration), see logic/fields.mjs -->
		<div each={field in fieldList()} class="form-group p-0 m-0 {isMissing(field) ? 'has-validation-error' : ''}">
			<div class="input-group flex-nowrap">
				<label class="input-group-text" style={LABEL_STYLE} for={fieldId('field-' + field.key)}>
					<span aria-hidden="true" class="icon-wrapper me-2"><svg><use href="{GoobiIcons.iconHref(fieldIcon(field))}" /></svg></span>
					{field.label}{field.required ? ' *' : ''}
				</label>
				<div class="newspaper-field {field.display === 'textarea' ? 'grow-wrap' : ''} {field.overwritten ? 'newspaper-field--overwritten' : ''}" data-content={field.value}
					data-field-wrapper={field.key}>
					<select if={field.display === 'select1'} class="form-select" id={fieldId('field-' + field.key)} onchange={e => props.handleValue(field.key, e.target.value)}>
						<option value="" selected={!field.value}>{props.t('plugin_newspaperRecognizer_pleaseSelect')}</option>
						<option if={field.value && !field.items.some(item => item.value === field.value)} value={field.value} selected>{field.value}</option>
						<option each={item in field.items} value={item.value} selected={item.value === field.value}>{item.label}</option>
					</select>
					<textarea if={field.display === 'textarea'} class="form-control" rows="1" id={fieldId('field-' + field.key)} data-field-key={field.key}
						oninput={e => props.handleValue(field.key, e.target.value)}></textarea>
					<input if={field.display === 'input' || field.display === 'readonly'} type="text" class="form-control" id={fieldId('field-' + field.key)}
						value={field.value} readonly={field.display === 'readonly'} oninput={e => props.handleValue(field.key, e.target.value)} />
					<button if={field.overwritten && !field.stale && field.display !== 'readonly'} type="button" class="btn btn-blank newspaper-field__reset"
						title={props.t('plugin_newspaperRecognizer_field_reset')} aria-label={props.t('plugin_newspaperRecognizer_field_reset')}
						onclick={() => props.handleReset(field.key)}>
						<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('arrow-back-up')}" /></svg></span>
					</button>
					<!-- the generated value changed after the value was overwritten: offer it without a dialog -->
					<button if={field.stale && field.display !== 'readonly'} type="button" class="btn btn-blank newspaper-field__reset newspaper-field__reset--stale"
						title={props.t('plugin_newspaperRecognizer_field_changed')} aria-label={props.t('plugin_newspaperRecognizer_field_changed')}
						aria-expanded={state.bubble === field.key ? 'true' : 'false'} onclick={() => toggleBubble(field.key)}>
						<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('refresh')}" /></svg></span>
					</button>
					<plugin-popover if={field.stale && state.bubble === field.key} title={props.t('plugin_newspaperRecognizer_field_changed')} handle-close={() => toggleBubble(field.key)}>
						<div class="fw-semibold mb-2 text-break">{field.generated}</div>
						<div class="d-flex gap-2 justify-content-end">
							<button type="button" class="btn btn-blank btn-sm" onclick={() => closeBubble(() => props.handleKeep(field.key))}>{props.t('plugin_newspaperRecognizer_field_keep')}</button>
							<button type="button" class="btn btn-primary btn-sm" onclick={() => closeBubble(() => props.handleReset(field.key))}>{props.t('uebernehmen')}</button>
						</div>
					</plugin-popover>
				</div>
			</div>
			<span if={isMissing(field)} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_missingRequired')}</span>
		</div>
		<div if={props.pageFirst || hiddenCount() > 0} class="d-flex justify-content-between align-items-center gap-3 small border-top pt-2 position-relative">
			<span class="text-muted">{props.pageFirst ? pagesText() : ''}</span>
			<button if={hiddenCount() > 0} type="button" class="btn btn-link btn-sm p-0 d-flex align-items-center gap-1 text-decoration-none"
				onclick={() => props.handleToggleHidden()} aria-expanded={props.hiddenOpen ? 'true' : 'false'}>
				<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('info-circle')}" /></svg></span>
				<span>{hiddenText()}</span>
			</button>
			<hidden-popover if={props.hiddenOpen} summary={props.start.hidden} t={props.t}
				handle-close={() => props.handleToggleHidden()} handle-remove={props.handleRemoveHidden}></hidden-popover>
		</div>
	</div>

	<script>
	import HiddenPopover from './hidden-popover.riot'
	import PluginPopover from './plugin-popover.riot'

	let counter = 0;

	export default {
		components: {
			HiddenPopover,
			PluginPopover,
		},
		// all labels get the same width, so the fields of a block line up
		LABEL_STYLE: 'min-width: 6.5rem;',
		// Riot sets value={…} on a textarea as an attribute, which a textarea ignores: its text is the value property
		onMounted() {
			this.syncTextareas();
			this.rememberGenerated();
		},
		onUpdated() {
			this.syncTextareas();
			this.flashUpdated();
			this.rememberGenerated();
		},
		toggleBubble(key) {
			this.update({ bubble: this.state.bubble === key ? null : key });
		},
		closeBubble(action) {
			this.update({ bubble: null });
			action();
		},
		// shown values that follow the generated value, per type and field, to notice when a change of date or number updates them
		rememberGenerated() {
			this.shownGenerated = Object.fromEntries(this.fieldList().filter(f => f.pattern != null && !f.overwritten)
				.map(f => [this.props.start.type + ':' + f.key, f.value]));
		},
		flashUpdated() {
			const before = this.shownGenerated || {};
			for (const field of this.fieldList()) {
				const key = this.props.start.type + ':' + field.key;
				if (field.pattern == null || field.overwritten || !(key in before) || before[key] === field.value) {
					continue;
				}
				const wrapper = this.root.querySelector(`[data-field-wrapper="${field.key}"]`);
				if (wrapper) {
					wrapper.classList.remove('newspaper-field--updated');
					void wrapper.offsetWidth; // restart the animation
					wrapper.classList.add('newspaper-field--updated');
				}
			}
		},
		syncTextareas() {
			this.root.querySelectorAll('textarea[data-field-key]').forEach(textarea => {
				const field = this.fieldList().find(f => f.key === textarea.dataset.fieldKey);
				if (field && textarea.value !== field.value) {
					textarea.value = field.value;
				}
			});
		},
		onBeforeMount() {
			this.fieldPrefix = 'blockField' + (++counter);
			this.state = { bubble: null }; // key of the field whose changed generated value is shown
		},
		fieldId(name) {
			return this.fieldPrefix + '-' + name;
		},
		fieldList() {
			return this.props.fields || [];
		},
		fieldIcon(field) {
			return { textarea: 'align-left', select1: 'selector', readonly: 'lock' }[field.display] || 'letter-case';
		},
		isMissing(field) {
			return field.required && !String(field.value).trim();
		},
		structures() {
			return (this.props.start.hidden && this.props.start.hidden.structures) || [];
		},
		metadata() {
			return (this.props.start.hidden && this.props.start.hidden.metadata) || [];
		},
		hiddenCount() {
			return this.structures().length + this.metadata().length;
		},
		pagesText() {
			if (this.props.pageFirst === this.props.pageLast) {
				return this.props.t('plugin_newspaperRecognizer_pagesSummarySingle').replace('{0}', this.props.pageFirst);
			}
			return this.props.t('plugin_newspaperRecognizer_pagesSummary')
				.replace('{0}', this.props.pageLast - this.props.pageFirst + 1)
				.replace('{1}', this.props.pageFirst)
				.replace('{2}', this.props.pageLast);
		},
		hiddenText() {
			const parts = [];
			if (this.structures().length > 0) {
				parts.push(this.props.t('plugin_newspaperRecognizer_hidden_structureCount').replace('{0}', this.structures().length));
			}
			if (this.metadata().length > 0) {
				parts.push(this.props.t('plugin_newspaperRecognizer_hidden_metadataCount').replace('{0}', this.metadata().length));
			}
			return parts.join(', ');
		},
	}
	</script>
</block-fields>
