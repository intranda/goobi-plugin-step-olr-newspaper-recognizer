<hidden-popover>
	<plugin-popover title={props.t('plugin_newspaperRecognizer_hidden_title')} align={props.align === 'left' ? 'start' : 'end'} handle-close={() => props.handleClose()}>
		<div class="d-flex flex-column gap-2">
			<p class="mb-0 text-muted">{props.t('plugin_newspaperRecognizer_hidden_hint')}</p>
			<div if={structures().length > 0}>
				<strong>{props.t('plugin_newspaperRecognizer_hidden_structures')}</strong>
				<ul class="mb-0">
					<li each={structure in structures()}>{structure.label}{structure.title ? ' – ' + structure.title : ''} ({pages(structure)})</li>
				</ul>
			</div>
			<div if={metadata().length > 0}>
				<strong>{props.t('plugin_newspaperRecognizer_hidden_metadata')}</strong>
				<ul class="mb-0">
					<li each={entry in metadata()}>{entry.label}: {entry.value}</li>
				</ul>
			</div>
			<div if={props.handleRemove} class="text-end">
				<button type="button" class="btn btn-hot btn-sm" onclick={() => props.handleRemove()}>{props.t('plugin_newspaperRecognizer_hidden_remove')}</button>
			</div>
		</div>
	</plugin-popover>

	<script>
	import PluginPopover from './plugin-popover.riot'

	export default {
		components: {
			PluginPopover,
		},
		structures() {
			return (this.props.summary && this.props.summary.structures) || [];
		},
		metadata() {
			return (this.props.summary && this.props.summary.metadata) || [];
		},
		pages(structure) {
			if (structure.firstPage < 0) {
				return this.props.t('plugin_newspaperRecognizer_hidden_noPages');
			}
			return this.props.t('plugin_newspaperRecognizer_hidden_pages')
				.replace('{0}', structure.firstPage + 1)
				.replace('{1}', structure.lastPage + 1);
		},
	}
	</script>
</hidden-popover>
