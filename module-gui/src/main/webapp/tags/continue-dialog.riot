<continue-dialog>
	<plugin-modal title={props.t('plugin_newspaperRecognizer_continue_title')} size="xl" close-label={props.t('cancel')} handle-close={() => props.handleCancel()}>
		<!-- options and preview side by side, stacked on small screens -->
		<div class="row g-4">
			<div class="col-12 col-lg-5 d-flex flex-column gap-3">
				<fieldset>
					<legend class="fs-6 fw-bold">{props.t('plugin_newspaperRecognizer_continue_include')}</legend>
					<div each={option in generatable()} class="form-check">
						<input class="form-check-input" type="checkbox" id={'include-' + option.name} checked={state.include.includes(option.name)}
							disabled={option.name === startType()} onchange={() => toggleInclude(option.name)} />
						<label class="form-check-label" for={'include-' + option.name}>{option.label}</label>
					</div>
				</fieldset>
				<fieldset>
					<legend class="fs-6 fw-bold">{props.t('plugin_newspaperRecognizer_continue_date')}</legend>
					<div class="form-check">
						<input class="form-check-input" type="radio" name="continue-dateMode" id="continue-dateRepeat" checked={state.dateMode === 'perDay'} onchange={() => update({ dateMode: 'perDay' })} />
						<label class="form-check-label" for="continue-dateRepeat">{props.t('plugin_newspaperRecognizer_continue_dateRepeat')}</label>
					</div>
					<div class="form-check">
						<input class="form-check-input" type="radio" name="continue-dateMode" id="continue-datePerIssue" checked={state.dateMode === 'perIssue'} onchange={() => update({ dateMode: 'perIssue' })} />
						<label class="form-check-label" for="continue-datePerIssue">{props.t('plugin_newspaperRecognizer_continue_datePerIssue')}</label>
					</div>
				</fieldset>
				<fieldset>
					<legend class="fs-6 fw-bold">{props.t('plugin_newspaperRecognizer_continue_number')}</legend>
					<div class="form-check">
						<input class="form-check-input" type="radio" name="continue-mode" id="continue-perDay" checked={state.mode === 'perDay'} onchange={() => update({ mode: 'perDay' })} />
						<label class="form-check-label" for="continue-perDay">{props.t('plugin_newspaperRecognizer_continue_perDay')}</label>
					</div>
					<div class="form-check">
						<input class="form-check-input" type="radio" name="continue-mode" id="continue-perIssue" checked={state.mode === 'perIssue'} onchange={() => update({ mode: 'perIssue' })} />
						<label class="form-check-label" for="continue-perIssue">{props.t('plugin_newspaperRecognizer_continue_perIssue')}</label>
					</div>
				</fieldset>
				<fieldset>
					<legend class="fs-6 fw-bold">{props.t('plugin_newspaperRecognizer_continue_weekdays')}</legend>
					<!-- one joined row like a calendar week, quick choices below -->
					<div class="btn-group weekday-toggle" role="group" aria-label={props.t('plugin_newspaperRecognizer_continue_weekdays')}>
						<!-- toggle buttons: their look follows the state (Riot sets checked only as attribute, which a clicked checkbox ignores) -->
						<button each={day in DAYS} type="button" class="btn {state.weekdays[day.index] ? 'active' : ''}" aria-pressed={state.weekdays[day.index] ? 'true' : 'false'}
							title={props.t(day.key)} aria-label={props.t(day.key)} onclick={() => toggleDay(day.index)}>{props.t(day.key).slice(0, 2)}</button>
					</div>
					<div class="d-flex flex-wrap column-gap-3 mt-1">
						<button each={preset in PRESETS} type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick={() => applyPreset(preset.name)}>
							{props.t(preset.key)}
						</button>
					</div>
					<div class="form-check form-switch mt-2">
						<input class="form-check-input" type="checkbox" role="switch" id="continue-biweekly" checked={state.biweekly} onchange={() => update({ biweekly: !state.biweekly })} />
						<label class="form-check-label" for="continue-biweekly">{props.t('plugin_newspaperRecognizer_biWeekly')}</label>
					</div>
				</fieldset>
			</div>

			<div class="col-12 col-lg-7 continue-preview">
			<h5 class="mb-2">{props.t('plugin_newspaperRecognizer_preview')}</h5>
			<div if={result().error} class="alert alert-warning mb-0">{props.t('plugin_newspaperRecognizer_continue_error_' + result().error)}</div>

			<table if={!result().error} class="table table-sm mb-0 preview-table">
				<colgroup><col class="preview-col-block" /><col /><col class="preview-col-date" /><col class="preview-col-number" /><col class="preview-col-note" /></colgroup>
				<thead>
					<tr>
						<th scope="col">{props.t('plugin_newspaperRecognizer_preview_block')}</th>
						<th scope="col">{props.t('plugin_newspaperRecognizer_preview_type')}</th>
						<th scope="col">{props.t('plugin_newspaperRecognizer_preview_date')}</th>
						<th scope="col">{props.t('plugin_newspaperRecognizer_preview_number')}</th>
						<th scope="col" class="preview-note">{props.t('plugin_newspaperRecognizer_preview_note')}</th>
					</tr>
				</thead>
				<tbody>
					<tr each={row in result().preview.slice(0, 20)} class={row.note === 'notIncluded' ? 'text-muted' : ''}>
						<td><div class="d-flex align-items-center gap-2"><img if={thumb(row.ref.page)} src={thumb(row.ref.page)} alt="" class="preview-thumb" loading="lazy" /><span>{row.ref.page + 1}</span></div></td>
						<td>
							{label(row.type)}
							<!-- on narrow screens the note column is hidden, the note follows the type -->
							<div if={row.note} class="preview-note-inline small text-muted">{props.t('plugin_newspaperRecognizer_continue_note_' + row.note)}</div>
						</td>
						<td>{formatDate(row.date)}</td>
						<td>{row.number || '—'}</td>
						<td class="preview-note">{row.note ? props.t('plugin_newspaperRecognizer_continue_note_' + row.note) : ''}</td>
					</tr>
				</tbody>
			</table>
			<p if={!result().error && result().preview.length > 20} class="mb-0 text-muted">
				{props.t('plugin_newspaperRecognizer_preview_more').replace('{0}', result().preview.length - 20)}
			</p>
			</div>
		</div>
		<template slot="footer">
			<span class="me-auto text-muted">{props.t('plugin_newspaperRecognizer_continue_footer')}</span>
			<button type="button" class="btn btn-blank" onclick={() => props.handleCancel()}>{props.t('cancel')}</button>
			<button type="button" class="btn btn-success" disabled={!!result().error || result().count === 0} onclick={apply}>
				{props.t('plugin_newspaperRecognizer_apply').replace('{0}', result().count || 0)}
			</button>
		</template>
	</plugin-modal>

	<script>
	import { buildTree, siblingsFrom } from '../logic/blocks.mjs'
	import { continueFrom } from '../logic/generation.mjs'
	import { fromIso, formatByPattern, WEEKDAY_PRESETS } from '../logic/dates.mjs'

	import PluginModal from './plugin-modal.riot'

	export default {
		components: {
			PluginModal,
		},
		// index = weekday() of logic/dates.mjs (0 = Sunday)
		DAYS: [
			{ index: 1, key: 'plugin_newspaperRecognizer_monday' },
			{ index: 2, key: 'plugin_newspaperRecognizer_tuesday' },
			{ index: 3, key: 'plugin_newspaperRecognizer_wednesday' },
			{ index: 4, key: 'plugin_newspaperRecognizer_thursday' },
			{ index: 5, key: 'plugin_newspaperRecognizer_friday' },
			{ index: 6, key: 'plugin_newspaperRecognizer_saturday' },
			{ index: 0, key: 'plugin_newspaperRecognizer_sunday' },
		],
		applyPreset(name) {
			this.update({ weekdays: [...WEEKDAY_PRESETS[name]] });
		},
		PRESETS: [
			{ name: 'daily', key: 'plugin_newspaperRecognizer_weekdays_daily' },
			{ name: 'monToSat', key: 'plugin_newspaperRecognizer_weekdays_monToSat' },
			{ name: 'monToFri', key: 'plugin_newspaperRecognizer_weekdays_monToFri' },
		],
		onBeforeMount(props) {
			this.state = {
				include: [this.startType()],
				mode: 'perDay',
				dateMode: 'perDay',
				weekdays: [true, true, true, true, true, true, true],
				biweekly: false,
			};
		},
		startType() {
			const first = siblingsFrom(buildTree(this.props.pages), this.props.startRef)[0];
			return first ? first.start.type : null;
		},
		generatable() {
			return this.props.typeOptions.filter(option => {
				const info = this.props.catalog[option.name] || {};
				return info.dated || info.numbered;
			});
		},
		toggleInclude(type) {
			const include = this.state.include.includes(type) ? this.state.include.filter(t => t !== type) : [...this.state.include, type];
			this.update({ include });
		},
		toggleDay(index) {
			const weekdays = [...this.state.weekdays];
			weekdays[index] = !weekdays[index];
			this.update({ weekdays });
		},
		result() {
			return continueFrom(this.props.pages, this.props.startRef, {
				include: this.state.include, mode: this.state.mode, dateMode: this.state.dateMode, weekdays: this.state.weekdays, biweekly: this.state.biweekly,
			}, this.props.catalog);
		},
		thumb(index) {
			const page = this.props.pages[index];
			return (page && page.image && page.image.thumbnailUrl) || null;
		},
		label(type) {
			return type ? (this.props.catalog[type] || {}).label || type : this.props.t('plugin_newspaperRecognizer_pleaseSelect');
		},
		formatDate(iso) {
			const date = fromIso(iso);
			return date ? formatByPattern(date, this.props.dateFormatPattern) : '—';
		},
		apply() {
			const result = this.result();
			if (!result.error) {
				this.props.handleApply(result.pages);
			}
		},
	}
	</script>
</continue-dialog>
