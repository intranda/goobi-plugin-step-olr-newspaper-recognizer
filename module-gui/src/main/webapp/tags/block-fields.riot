<block-fields>
	<div class="d-flex flex-column gap-2">
		<div class="d-flex align-items-start gap-2">
			<span if={props.color} aria-hidden="true" style="display: inline-block; flex: 0 0 20px; width: 20px; height: 20px; margin-top: 8px; border-radius: 50%; background: {props.color};"></span>
			<div class="form-group px-0 flex-grow-1 mb-0 {props.flags.missingType || props.flags.notAllowed ? 'has-validation-error' : ''}">
				<select class="form-select w-100" aria-label={props.t('plugin_newspaperRecognizer_blockType')} onchange={e => props.handleType(e.target.value || null)}>
					<option value="" selected={!props.start.type}>{props.t('plugin_newspaperRecognizer_pleaseSelect')}</option>
					<option each={option in props.typeOptions} value={option.name} selected={option.name === props.start.type}>{option.label}</option>
				</select>
				<span if={props.flags.missingType} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_missingType')}</span>
				<span if={props.flags.notAllowed} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_notAllowed')}</span>
			</div>
			<slot name="badge" />
			<div class="d-flex flex-nowrap gap-1 align-self-start">
				<slot name="actions" />
			</div>
		</div>

		<div if={props.info && props.info.dated} class="form-group px-0 {props.flags.invalidDate || props.flags.missingDate || props.flags.duplicate ? 'has-validation-error' : ''}">
			<input type="text" class="form-control" value={props.start.dateInput}
				aria-label={props.t('plugin_newspaperRecognizer_date')}
				placeholder={props.t('plugin_newspaperRecognizer_date') + (props.info.dateRequired ? ' *' : '')}
				onkeyup={e => props.handleDate(e.target.value)} onblur={e => props.handleDate(e.target.value)} />
			<span if={props.flags.invalidDate} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_wrongDateFormat')} {props.dateFormatPattern}</span>
			<span if={props.flags.missingDate} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_missingRequired')}</span>
			<span if={props.flags.duplicate} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_duplicate')}</span>
		</div>

		<div if={props.info && props.info.numbered} class="form-group px-0 {props.flags.missingNumber ? 'has-validation-error' : ''}">
			<div class="input-group">
				<input if={props.info.partNumbered} type="text" class="form-control" style="width: 33%" value={props.start.prefix || ''}
					aria-label={props.t('prefix')} placeholder={props.t('prefix')} onkeyup={e => props.handleField('prefix', e.target.value)} />
				<input type="text" class="form-control" style="width: 34%" value={props.start.number || ''}
					aria-label={props.t('plugin_newspaperRecognizer_nro')}
					placeholder={props.t('plugin_newspaperRecognizer_nro') + (props.info.numberRequired ? ' *' : '')}
					onkeyup={e => props.handleField('number', e.target.value)} />
				<input if={props.info.partNumbered} type="text" class="form-control" style="width: 33%" value={props.start.suffix || ''}
					aria-label={props.t('suffix')} placeholder={props.t('suffix')} onkeyup={e => props.handleField('suffix', e.target.value)} />
			</div>
			<span if={props.flags.missingNumber} class="help-inline text-danger">{props.t('plugin_newspaperRecognizer_validation_missingRequired')}</span>
		</div>

	</div>
</block-fields>
