<type-pattern-dialog>
	<plugin-modal title={props.t('plugin_newspaperRecognizer_typePattern_title')} size="xl" close-label={props.t('cancel')} handle-close={() => props.handleCancel()}>
		<!-- pattern and preview side by side, stacked on small screens -->
		<div class="row g-4">
			<div class="col-12 col-lg-5">
				<h5 class="mb-2">{props.t('plugin_newspaperRecognizer_typePattern_steps')}</h5>
				<ol class="list-unstyled d-flex flex-column gap-2 mb-2">
					<li each={(type, index) in state.pattern} class="pattern-step {state.dragging === index ? 'pattern-step--dragging' : ''}"
						style="--position-color: {color(index)};" draggable="true"
						ondragstart={e => dragStart(e, index)} ondragover={e => dragOver(e, index)} ondragend={dragEnd}>
						<button type="button" class="btn btn-blank btn-sm pattern-step__grip" title={props.t('plugin_newspaperRecognizer_typePattern_move')}
							aria-label={props.t('plugin_newspaperRecognizer_typePattern_move') + ' ' + (index + 1)} onkeydown={e => moveByKey(e, index)}>
							<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('grip-vertical')}" /></svg></span>
						</button>
						<span class="pattern-step__no" aria-hidden="true">{index + 1}</span>
						<select class="form-select form-select-sm" aria-label={props.t('plugin_newspaperRecognizer_typePattern_entry') + ' ' + (index + 1)}
							onchange={e => setEntry(index, e.target.value)}>
							<option each={option in props.typeOptions} value={option.name} selected={option.name === type}>{option.label}</option>
						</select>
						<button type="button" class="btn btn-blank btn-sm" disabled={state.pattern.length < 2} onclick={() => removeEntry(index)}
							title={props.t('plugin_newspaperRecognizer_typePattern_removeEntry')} aria-label={props.t('plugin_newspaperRecognizer_typePattern_removeEntry') + ' ' + (index + 1)}>
							<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('x')}" /></svg></span>
						</button>
					</li>
				</ol>
				<button type="button" class="btn btn-blank btn-sm d-inline-flex align-items-center gap-1" onclick={addEntry}>
					<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('plus')}" /></svg></span>
					<span>{props.t('plugin_newspaperRecognizer_typePattern_add')}</span>
				</button>
				<p class="small text-muted mt-3 mb-2 d-flex gap-2">
					<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('repeat')}" /></svg></span>
					<span>{props.t('plugin_newspaperRecognizer_typePattern_repeats').replace('{0}', state.pattern.length)}</span>
				</p>
				<p class="small text-muted mb-0">{props.t('plugin_newspaperRecognizer_typePattern_hint')}</p>
			</div>
			<div class="col-12 col-lg-7">
				<h5 class="mb-2">{props.t('plugin_newspaperRecognizer_preview')}</h5>
				<table class="table table-sm mb-0 preview-table">
					<colgroup><col class="preview-col-block" /><col /><col /></colgroup>
					<thead>
						<tr>
							<th scope="col">{props.t('plugin_newspaperRecognizer_preview_block')}</th>
							<th scope="col">{props.t('plugin_newspaperRecognizer_preview_before')}</th>
							<th scope="col">{props.t('plugin_newspaperRecognizer_preview_after')}</th>
						</tr>
					</thead>
					<tbody>
						<tr each={row in rows()}>
							<td><div class="d-flex align-items-center gap-2"><img if={row.thumb} src={row.thumb} alt="" class="preview-thumb" loading="lazy" /><span>{row.page}</span></div></td>
							<td class="text-muted">{row.before}</td>
							<td class={row.before !== row.after ? 'fw-bold' : ''}>
								<span class="position-dot" style="background: {color(row.position)};" aria-hidden="true"></span>{row.after}
							</td>
						</tr>
					</tbody>
				</table>
				<p if={siblings().length > 20} class="small text-muted mt-2 mb-0">{props.t('plugin_newspaperRecognizer_preview_more').replace('{0}', siblings().length - 20)}</p>
			</div>
		</div>
		<template slot="footer">
			<button type="button" class="btn btn-blank" onclick={() => props.handleCancel()}>{props.t('cancel')}</button>
			<button type="button" class="btn btn-success" onclick={() => props.handleApply(state.pattern)}>
				{props.t('plugin_newspaperRecognizer_apply').replace('{0}', siblings().length)}
			</button>
		</template>
	</plugin-modal>

	<script>
	import { buildTree, siblingsFrom } from '../logic/blocks.mjs'
	import { positionColor } from '../logic/colors.mjs'
	import { movePatternEntry } from '../logic/generation.mjs'

	import PluginModal from './plugin-modal.riot'

	const thumbnail = page => (page && page.image && page.image.thumbnailUrl) || null;

	export default {
		components: {
			PluginModal,
		},
		onBeforeMount(props) {
			const first = siblingsFrom(buildTree(props.pages), props.startRef)[0];
			const names = props.typeOptions.map(option => option.name);
			const initial = first && names.includes(first.start.type) ? first.start.type : names[0];
			this.state = { pattern: [initial], dragging: null };
		},
		siblings() {
			return siblingsFrom(buildTree(this.props.pages), this.props.startRef);
		},
		label(type) {
			if (!type) {
				return this.props.t('plugin_newspaperRecognizer_pleaseSelect');
			}
			return (this.props.catalog[type] || {}).label || type;
		},
		rows() {
			const pattern = this.state.pattern;
			return this.siblings().slice(0, 20).map((node, i) => ({
				page: node.first + 1,
				thumb: thumbnail(this.props.pages[node.first]),
				before: this.label(node.start.type),
				after: this.label(pattern[i % pattern.length]),
				position: i % pattern.length,
			}));
		},
		setEntry(index, type) {
			const pattern = [...this.state.pattern];
			pattern[index] = type;
			this.update({ pattern });
		},
		addEntry() {
			this.update({ pattern: [...this.state.pattern, this.state.pattern[this.state.pattern.length - 1]] });
		},
		color(position) {
			return positionColor(position);
		},
		dragStart(e, index) {
			e.dataTransfer.effectAllowed = 'move';
			e.dataTransfer.setData('text/plain', String(index));
			this.update({ dragging: index });
		},
		/* the entry follows the pointer while dragging, so the preview shows the new order right away */
		dragOver(e, index) {
			e.preventDefault();
			if (this.state.dragging !== null && this.state.dragging !== index) {
				this.update({ pattern: movePatternEntry(this.state.pattern, this.state.dragging, index), dragging: index });
			}
		},
		dragEnd() {
			this.update({ dragging: null });
		},
		moveByKey(e, index) {
			const to = e.key === 'ArrowUp' ? index - 1 : e.key === 'ArrowDown' ? index + 1 : null;
			if (to === null || to < 0 || to >= this.state.pattern.length) {
				return;
			}
			e.preventDefault();
			this.update({ pattern: movePatternEntry(this.state.pattern, index, to) });
			this.root.querySelectorAll('.pattern-step__grip')[to].focus();
		},
		removeEntry(index) {
			this.update({ pattern: this.state.pattern.filter((type, i) => i !== index) });
		},
	}
	</script>
</type-pattern-dialog>
