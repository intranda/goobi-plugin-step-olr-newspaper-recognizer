<label-input>
	<!-- the label of a page under its thumbnail; the input is unobtrusive (border on hover and focus), see the pagination v2 design, Typing -->
	<div data-label={props.index + 1} class="label-input {stateClasses()}">
		<input type="text" class="form-control form-control-sm" data-label-input={props.index + 1} autocomplete="off"
			placeholder={props.t('plugin_newspaperRecognizer_pagination_label_placeholder')}
			aria-label={props.t('plugin_newspaperRecognizer_pagination_label_aria').replace('{0}', () => props.index + 1)}
			title={props.own ? props.t('plugin_newspaperRecognizer_pagination_label_own').replace('{0}', () => props.follow) : ''}
			onfocus={onFocus} oninput={onInput} onkeydown={onKeyDown} onblur={onBlur} />
	</div>

	<script>
	import { isCounting } from '../logic/labels.mjs'

	export default {
		onBeforeMount() {
			this.editing = false; // the text in the field is the user's, not the page's
			this.dirty = false;
			this.text = '';
		},

		onMounted() {
			this.sync();
		},

		onUpdated() {
			this.sync();
		},

		/* what the field shows: the typed text, the would-be result while another page is typed, else the label */
		shown() {
			if (this.editing) {
				return this.text;
			}
			const preview = this.props.preview;
			if (preview && this.changesInPreview()) {
				return preview.pages[this.props.index].label;
			}
			return this.props.page.label;
		},

		/* only pages whose label really changes are highlighted */
		changesInPreview() {
			const preview = this.props.preview;
			return !!preview && preview.run.includes(this.props.index) && preview.pages[this.props.index].label !== this.props.page.label;
		},

		stateClasses() {
			const preview = this.props.preview;
			return [
				this.changesInPreview() ? 'is-preview' : '',
				// a page without counting label that ends a run has no own numbering to point out
				preview && preview.stop === this.props.index && isCounting(this.props.page.label) ? 'is-stop' : '',
				this.props.own ? 'is-own' : '',
				this.props.changed ? 'is-changed' : '',
			].filter(Boolean).join(' ');
		},

		/* a bound value is only written when the expression changes, but the user typed over it */
		sync() {
			const input = this.$('input');
			const value = this.shown();
			if (input && input.value !== value) {
				input.value = value;
			}
		},

		onFocus() {
			if (this.editing) {
				return; // focus given back after a re-render, the text is being typed
			}
			this.editing = true;
			this.dirty = false;
			this.text = this.props.page.label;
		},

		onInput(e) {
			if (!this.editing) {
				this.editing = true;
				this.text = this.props.page.label;
			}
			this.dirty = true;
			this.text = e.target.value;
			this.props.handlePreview(this.text, 'follow');
		},

		/* Enter: this page and the following ones that count on; Shift: this page only; Ctrl: on to the end of the stream */
		onKeyDown(e) {
			if (e.key === 'Enter') {
				e.preventDefault();
				this.finish(e.ctrlKey || e.metaKey ? 'toEnd' : e.shiftKey ? 'single' : 'follow');
			} else if (e.key === 'Escape') {
				e.preventDefault();
				this.editing = false;
				this.dirty = false;
				this.props.handleCancel();
			} else if (e.key === 'Tab') {
				this.finish('follow');
				// at the first and the last field the browser's own Tab goes on, so the field is no keyboard trap
				if (this.props.handleMove(e.shiftKey ? -1 : 1)) {
					e.preventDefault();
				}
			}
		},

		onBlur() {
			if (this.props.isRendering && this.props.isRendering()) {
				return; // the page is only being re-rendered around the field
			}
			if (this.editing) {
				this.finish('follow');
			}
		},

		/* leaving a field without having changed its text is no edit */
		finish(mode) {
			const text = this.text;
			const edited = this.dirty;
			this.editing = false;
			this.dirty = false;
			if (edited) {
				this.props.handleCommit(text, mode);
			} else {
				this.props.handleCancel();
			}
		},
	}
	</script>
</label-input>
