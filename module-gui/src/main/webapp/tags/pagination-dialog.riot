<pagination-dialog>
	<plugin-modal title={props.t('plugin_newspaperRecognizer_pagination_rules_title')} size="xl" attributes={{ 'data-pagination-dialog': 'true' }} close-label={props.t('cancel')} handle-close={() => props.handleCancel()}>
		<!-- rules and preview side by side, stacked on small screens -->
		<div class="row g-4">
			<div class="col-12 col-lg-6 d-flex flex-column gap-3">
				<fieldset>
					<legend class="fs-6 fw-bold">{props.t('plugin_newspaperRecognizer_pagination_rules_heading')}</legend>
					<p class="small text-muted mb-2">{props.t('plugin_newspaperRecognizer_pagination_rules_session')}</p>
					<table class="table table-sm mb-2">
						<thead>
							<tr>
								<th scope="col">{props.t('plugin_newspaperRecognizer_pagination_rules_block')}</th>
								<th scope="col">{props.t('plugin_newspaperRecognizer_pagination_rules_beginsWith')}</th>
							</tr>
						</thead>
						<tbody>
							<tr each={entry in ruleRows()} data-rule-row={entry.key}>
								<td>{entry.label}</td>
								<td>
									<div class="d-flex gap-2 flex-wrap align-items-center">
										<select class="form-select form-select-sm rules-preset" data-rule-preset aria-label={entry.label}
											onchange={e => setPreset(entry.key, e.target.value)}>
											<option each={option in presetsOf(entry)} value={option.value} selected={option.value === entry.preset}>{option.label}</option>
										</select>
										<input if={entry.preset === 'custom'} type="text" class="form-control form-control-sm rules-custom" data-rule-custom value={entry.custom}
											aria-label={props.t('plugin_newspaperRecognizer_pagination_rules_customLabel')}
											placeholder={props.t('plugin_newspaperRecognizer_pagination_rules_customPlaceholder')}
											oninput={e => setCustom(entry.key, e.target.value)} />
									</div>
									<div if={entry.child} class="form-check mt-1">
										<input type="checkbox" class="form-check-input" id={'rules-continue-' + entry.key} data-rule-continue checked={entry.continueInParent}
											onchange={e => setContinue(entry.key, e.target.checked)} />
										<label class="form-check-label" for={'rules-continue-' + entry.key}>{props.t('plugin_newspaperRecognizer_pagination_rules_continue')}</label>
									</div>
								</td>
							</tr>
						</tbody>
					</table>
					<div class="form-check">
						<input type="checkbox" class="form-check-input" id="rules-automatic" data-automatic checked={state.automatic}
							onchange={e => setAutomatic(e.target.checked)} />
						<label class="form-check-label" for="rules-automatic">{props.t('plugin_newspaperRecognizer_pagination_rules_automatic')}</label>
					</div>
				</fieldset>
				<fieldset>
					<legend class="fs-6 fw-bold">{props.t('plugin_newspaperRecognizer_pagination_rules_overwrite')}</legend>
					<div each={kind in scopeKinds()} class="form-check">
						<input type="radio" class="form-check-input" name="rules-scope" id={'rules-scope-' + kind} data-scope={kind} value={kind}
							checked={state.scope === kind} onchange={() => setScope(kind)} />
						<label class="form-check-label" for={'rules-scope-' + kind}>{props.t('plugin_newspaperRecognizer_pagination_rules_scope_' + kind)}</label>
					</div>
					<div class="form-text">{props.t('plugin_newspaperRecognizer_pagination_rules_untyped')}</div>
				</fieldset>
			</div>
			<div class="col-12 col-lg-6">
				<h5 class="mb-2">
					{props.t('plugin_newspaperRecognizer_preview')}
					<span data-preview-count class="small text-muted">{countText()}</span>
				</h5>
				<p if={state.scope === 'none'} class="text-muted small d-flex gap-2">
					<span aria-hidden="true" class="icon-wrapper"><svg><use href="{GoobiIcons.iconHref('info-circle')}" /></svg></span>
					<span>{props.t('plugin_newspaperRecognizer_pagination_rules_noneHint')}</span>
				</p>
				<table if={state.scope !== 'none'} class="table table-sm mb-0 preview-table">
					<colgroup><col class="preview-col-page" /><col class="preview-col-name" /><col /><col /></colgroup>
					<thead>
						<tr>
							<th scope="col">{props.t('plugin_newspaperRecognizer_preview_block')}</th>
							<th scope="col">{props.t('plugin_newspaperRecognizer_pagination_rules_block')}</th>
							<th scope="col">{props.t('plugin_newspaperRecognizer_preview_before')}</th>
							<th scope="col">{props.t('plugin_newspaperRecognizer_preview_after')}</th>
						</tr>
					</thead>
					<tbody>
						<tr each={row in visibleRows()} data-preview-row={row.page}>
							<td>{row.page}</td>
							<td data-preview-block>
								<span if={row.dot} data-preview-dot class="position-dot" style="background: {row.dot};" aria-hidden="true"></span>{row.block}
							</td>
							<td data-preview-before class="text-muted">{row.before}</td>
							<td data-preview-new class={row.before !== row.after ? 'preview-changed' : ''}>{row.after}</td>
						</tr>
					</tbody>
				</table>
				<p if={hiddenRows() > 0} class="small text-muted mt-2 mb-0">{props.t('plugin_newspaperRecognizer_preview_more').replace('{0}', hiddenRows())}</p>
			</div>
		</div>
		<template slot="footer">
			<button type="button" data-cancel class="btn btn-blank" onclick={() => props.handleCancel()}>{props.t('abbrechen')}</button>
			<button type="button" data-apply class="btn btn-success" onclick={apply}>{applyText()}</button>
		</template>
	</plugin-modal>

	<script>
	import { buildTree, flatten } from '../logic/blocks.mjs'
	import { streams } from '../logic/pagination.mjs'
	import { inScope, simulateRules } from '../logic/pagination-tools.mjs'
	import { positionColor } from '../logic/colors.mjs'

	import PluginModal from './plugin-modal.riot'

	// the rules offered besides "custom", with the key of their text
	const PRESET_KEYS = { '1': 'arabic', 'i': 'roman', 'I': 'romanUpper', '[1]': 'fictitious', '– 1': 'firstNone', '–': 'none' };
	const PRESETS = Object.keys(PRESET_KEYS);
	const LOOSE = '__loose__';
	const PREVIEW_ROWS = 20; // like the type pattern dialog; count and button still cover all pages of the scope

	const ruleToPreset = beginsWith => {
		if (!beginsWith || beginsWith.length === 0) {
			return { preset: '', custom: '' };
		}
		const text = beginsWith.join(' ');
		return PRESETS.includes(text) ? { preset: text, custom: '' } : { preset: 'custom', custom: text };
	};

	export default {
		components: {
			PluginModal,
		},

		onBeforeMount(props) {
			const rules = props.settings.rules || {};
			const rows = {};
			for (const type of props.types) {
				rows[type] = { ...ruleToPreset(rules[type] && rules[type].beginsWith), continueInParent: !!(rules[type] && rules[type].continueInParent) };
			}
			rows[LOOSE] = ruleToPreset(props.settings.withoutBlock);
			this.state = { rows, automatic: props.settings.automatic !== false, scope: props.first === null || props.first === undefined ? 'none' : 'block' };
		},

		visibleRows() {
			return this.view().rows.slice(0, PREVIEW_ROWS);
		},

		hiddenRows() {
			return Math.max(0, this.view().rows.length - PREVIEW_ROWS);
		},

		/* the preview of the current state, computed once for every state (the template asks for it several times) */
		view() {
			const key = JSON.stringify(this.state);
			if (this.cached?.key !== key) {
				this.cached = { key, value: this.compute() };
			}
			return this.cached.value;
		},

		/* the settings as they are edited: the rules of the types and the rule of the pages without block */
		draft() {
			const beginsWith = ({ preset, custom }) => (preset === 'custom' ? custom.split(/\s+/).filter(Boolean) : preset === '' ? [] : preset.split(' '));
			const rules = { ...(this.props.settings.rules || {}) };
			for (const type of this.props.types) {
				const row = this.state.rows[type];
				const values = beginsWith(row);
				if (values.length === 0) {
					delete rules[type];
				} else {
					rules[type] = { ...(rules[type] || {}), beginsWith: values, continueInParent: row.continueInParent };
				}
			}
			return { ...this.props.settings, automatic: this.state.automatic, rules, withoutBlock: beginsWith(this.state.rows[LOOSE]) };
		},

		scopeKinds() {
			const first = this.props.first;
			return first === null || first === undefined ? ['none', 'volume'] : ['none', 'block', 'fromBlock', 'volume'];
		},

		scope() {
			return { kind: this.state.scope, first: this.props.first };
		},

		/* the pages the scope covers with their label now and after the rules, in page order */
		compute() {
			const props = this.props;
			const draft = this.draft();
			const scope = this.scope();
			const indexes = streams(props.pages, draft).list.filter(inScope(scope)).flatMap(stream => stream.pages).sort((a, b) => a - b);
			const simulated = simulateRules(props.pages, draft, scope);
			const owners = this.blockOwners();
			const rows = indexes.map(i => ({
				page: i + 1,
				...this.blockCell(owners[i]),
				before: props.pages[i].label ?? '',
				after: simulated[i].label ?? '',
			}));
			return { rows, changed: rows.filter(row => row.before !== row.after).length };
		},

		/* per page its deepest block and, for a child, the number of the child block of the level-0 block */
		blockOwners() {
			const owners = new Array(this.props.pages.length).fill(null);
			for (const root of buildTree(this.props.pages).roots) {
				for (const node of flatten([root])) {
					const child = node.level === 0 ? 0 : root.children.findIndex(c => c.first <= node.first && node.first <= c.last) + 1;
					for (let i = node.first; i <= node.last; i++) {
						owners[i] = { node, child };
					}
				}
			}
			return owners;
		},

		blockCell(owner) {
			if (!owner) {
				return { block: this.props.t('plugin_newspaperRecognizer_pagination_withoutBlock'), dot: null };
			}
			const label = this.typeLabel(owner.node.start.type);
			return owner.child > 0 ? { block: `${label} ${owner.child}`, dot: positionColor(owner.child - 1) } : { block: label, dot: null };
		},

		typeLabel(type) {
			return type ? (this.props.catalog[type] || {}).label || type : this.props.t('plugin_newspaperRecognizer_pleaseSelect');
		},

		/* a row per type and one for the pages without block */
		ruleRows() {
			const children = new Set(this.props.types.flatMap(type => (this.props.catalog[type] || {}).children || []));
			return [
				...this.props.types.map(type => ({ key: type, label: this.typeLabel(type), child: children.has(type), ...this.state.rows[type] })),
				{ key: LOOSE, label: this.props.t('plugin_newspaperRecognizer_pagination_withoutBlock'), child: false, ...this.state.rows[LOOSE] },
			];
		},

		presetsOf(entry) {
			const options = PRESETS.map(value => ({ value, label: this.props.t('plugin_newspaperRecognizer_pagination_rules_preset_' + PRESET_KEYS[value]) }));
			options.push({ value: 'custom', label: this.props.t('plugin_newspaperRecognizer_pagination_rules_custom') });
			// a type without rule keeps the labels of its blocks (or the parent's stream); that stays selectable only as long as it is the current choice
			return entry.preset === '' ? [{ value: '', label: this.props.t('plugin_newspaperRecognizer_pagination_rules_noRule') }, ...options] : options;
		},

		setScope(scope) {
			this.update({ scope });
		},

		setAutomatic(automatic) {
			this.update({ automatic });
		},

		setRow(key, change) {
			this.update({ rows: { ...this.state.rows, [key]: { ...this.state.rows[key], ...change } } });
		},

		setPreset(key, preset) {
			this.setRow(key, { preset });
		},

		setCustom(key, custom) {
			this.setRow(key, { custom });
		},

		setContinue(key, continueInParent) {
			this.setRow(key, { continueInParent });
		},

		countText() {
			const changed = this.view().changed;
			if (this.state.scope === 'none') {
				return '';
			}
			if (changed === 0) {
				return '· ' + this.props.t('plugin_newspaperRecognizer_pagination_rules_unchanged');
			}
			return '· ' + this.props.t(changed === 1 ? 'plugin_newspaperRecognizer_pagination_rules_changedOne' : 'plugin_newspaperRecognizer_pagination_rules_changed').replace('{0}', changed);
		},

		applyText() {
			const changed = this.view().changed;
			if (this.state.scope === 'none' || changed === 0) {
				return this.props.t('plugin_newspaperRecognizer_pagination_rules_apply');
			}
			return this.props.t(changed === 1 ? 'plugin_newspaperRecognizer_pagination_rules_applyOverwriteOne' : 'plugin_newspaperRecognizer_pagination_rules_applyOverwrite').replace('{0}', changed);
		},

		apply() {
			this.props.handleApply(this.draft(), this.scope());
		},
	}
	</script>
</pagination-dialog>
