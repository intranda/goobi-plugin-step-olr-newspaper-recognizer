<config_plugin>
    <loadAllImages>true</loadAllImages>
    <showDeletePageButton>false</showDeletePageButton>
    <!-- block saving while two blocks of the same type with the same date and number share a parent -->
    <preventDuplicates>true</preventDuplicates>

    <!-- configurations related to pagination settings -->
    <pagination>
        <!-- whether or not to create a new pagination, if false then the old pagination will be used. DEFAULT true. -->
        <createNewPagination>true</createNewPagination>
        <!-- type of the paginations: - (none), 1 (1, 2, 3), i (i, ii, iii), I (I, II, III). DEFAULT 1. -->
        <type>1</type>
        <!-- whether or not to use the fake pagination [N]. DEFAULT false. -->
        <useFakePagination>false</useFakePagination>
    </pagination>

    <!--
        Structure types, their labels, their hierarchy and their metadata come from the ruleset.
        Fields: <defaults> applies to every type that allows the metadata, <type docstruct> adds fields or overrides a default
        field of the same key in place.
        - role="date" / role="number" (only in <defaults>): the date and number field of a block. A type gets the field if it
          allows the metadata. format: input format in the plugin, storeFormat: format of the metadata value (DEFAULT yyyy-MM-dd),
          partKey: prefix + number + suffix (without it the plugin offers no prefix and suffix fields).
        - without value: an editable field. With value: the generated value is shown and can be changed.
        - hidden="true": generated on save and not shown (requires value).
        Placeholders in value: {date:FORMAT}, {no}, {partNo}, {label} take the value of the block or of the nearest enclosing
        block; {parent.date:FORMAT}, {parent.no}, {parent.partNo}, {parent.label} only that of the direct parent. An empty
        placeholder writes [MISSING], or nothing with skipIfEmpty="true". Visible fields support the date tokens d, dd, M, MM,
        yy and yyyy.
        Label, input type and selection values of a field come from the metadata display rules of the project.
    -->
    <defaults>
        <field key="DateIssued" role="date" format="dd.MM.yyyy" storeFormat="yyyy-MM-dd" />
        <field key="CurrentNo" role="number" partKey="PartNumber" />
        <field key="TitleDocMain" />
        <field key="CurrentNoSorting" value="{no}" hidden="true" skipIfEmpty="true" />
    </defaults>
    <type docstruct="MorningIssue">
        <field key="TitleDocMain" value="Morgenausgabe {partNo} vom {date:dd.MM.yyyy}" />
    </type>
    <type docstruct="EveningIssue">
        <field key="TitleDocMain" value="Abendausgabe {partNo} vom {date:dd.MM.yyyy}" />
    </type>
    <type docstruct="NewspaperSupplement">
        <field key="TitleDocMain" value="Beilage zur {parent.no}. Ausgabe vom {date:dd.MM.yyyy}" />
    </type>
    <type docstruct="TableOfContents">
        <field key="TitleDocMain" value="Inhaltsverzeichnis" />
    </type>
</config_plugin>
